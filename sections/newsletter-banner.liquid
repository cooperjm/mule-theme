{{ 'newsletter-banner.css' | asset_url | stylesheet_tag }}

<section id="newsletter-banner">
  <div class="section-container">
    <div class="content">
      <div class="text-content">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.subheading }}</p>
      </div>
      <div class="form-content">
        {% render 'newsletter', form_id: form_id %}
      </div>
    </div>
  </div>
</section>

<style>
  #newsletter-banner {
    background-image: url('{{ section.settings.background_image | image_url }}');
  }

  @media (max-width: 930px) {
    #newsletter-banner {
      background-image: url('{{ section.settings.background_image_mobile | image_url }}');
      background-size: cover;
      background-position: center;
      padding-top: 60px;
      padding-bottom: 60px;
    }
  }
</style>

{% schema %}
{
  "name": "Newsletter Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay In The Loop With The Coolest Updates"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Subscribe and receive exclusive information and offers on MULE products!"
    },
    {
      "type": "url",
      "id": "form_action_url",
      "label": "Form Action URL"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Sign Up"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background Image Mobile"
    },
    {
      "type": "text",
      "id": "background_image_alt",
      "label": "Background Image Alt Text",
      "default": "Fan with MULE logo"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Banner",
      "category": "Sections"
    }
  ]
}
{% endschema %}
