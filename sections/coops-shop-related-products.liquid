{% liquid
  assign crp_source = section.settings.product_source
  assign crp_limit = section.settings.product_limit
  assign crp_products = blank
  assign crp_fallback_collection = section.settings.fallback_collection
  assign crp_current_product_id = product.id

  if crp_source == 'collection'
    assign crp_products = crp_fallback_collection.products
  elsif recommendations.products_count > 0
    assign crp_products = recommendations.products
  elsif crp_fallback_collection != blank
    assign crp_products = crp_fallback_collection.products
  elsif product.collections.first != blank
    assign crp_products = product.collections.first.products
  endif
%}

{% if crp_source == 'recommendations' and product != blank %}
  <script
    type="application/json"
    data-section-type="static-product-recommendations"
    data-section-id="{{ section.id }}"
    data-section-data
  >
    {
      "settings": {
        "limit": {{ crp_limit | json }}
      },
      "productId": {{ product.id | json }},
      "sectionId": {{ section.id | json }}
    }
  </script>
{% endif %}

{% style %}
  #shopify-section-{{ section.id }} .coops-related-products {
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .coops-related-products__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .coops-related-products__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: {{ section.settings.heading_color }};
    font-family: Oswald, sans-serif;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.15;
    text-align: {{ section.settings.heading_alignment }};
  }

  #shopify-section-{{ section.id }} .coops-related-products__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.card_gap }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .coops-related-products__card {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .coops-related-products__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: {{ section.settings.card_min_height }}px;
    overflow: hidden;
    background: {{ section.settings.card_background }};
    border-radius: {{ section.settings.card_radius }}px;
    box-shadow: 0 {{ section.settings.shadow_y }}px {{ section.settings.shadow_blur }}px rgba(0, 0, 0, {{ section.settings.shadow_opacity | divided_by: 100.0 }});
    color: {{ section.settings.text_color }};
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .coops-related-products__image-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ section.settings.image_height }}px;
    padding: {{ section.settings.image_padding }}px;
    background: {{ section.settings.image_background }};
  }

  #shopify-section-{{ section.id }} .coops-related-products__image {
    display: block;
    width: 100%;
    height: {{ section.settings.image_inner_height }}px;
    object-fit: {{ section.settings.image_fit }};
    mix-blend-mode: {{ section.settings.image_blend_mode }};
  }

  #shopify-section-{{ section.id }} .coops-related-products__placeholder {
    width: 100%;
    height: {{ section.settings.image_inner_height }}px;
    color: rgba(0, 0, 0, 0.12);
  }

  #shopify-section-{{ section.id }} .coops-related-products__info {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    padding: {{ section.settings.info_padding_top }}px {{ section.settings.info_padding_horizontal }}px {{ section.settings.info_padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .coops-related-products__title {
    margin: 0 0 6px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .coops-related-products__rating {
    min-height: 20px;
    margin: 0 0 4px;
  }

  #shopify-section-{{ section.id }} .coops-related-products__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    color: {{ section.settings.price_color }};
    font-size: {{ section.settings.price_size }}px;
    font-weight: {{ section.settings.price_weight }};
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .coops-related-products__compare-price {
    color: {{ section.settings.compare_price_color }};
    font-size: 0.9em;
    text-decoration: line-through;
  }

  @media screen and (max-width: 1023px) {
    #shopify-section-{{ section.id }} .coops-related-products__grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 719px) {
    #shopify-section-{{ section.id }} .coops-related-products {
      padding: {{ section.settings.padding_top_mobile }}px 16px {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .coops-related-products__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .coops-related-products__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ section.settings.card_gap_mobile }}px;
    }

    #shopify-section-{{ section.id }} .coops-related-products__link {
      min-height: {{ section.settings.card_min_height_mobile }}px;
    }

    #shopify-section-{{ section.id }} .coops-related-products__image-wrap {
      min-height: {{ section.settings.image_height_mobile }}px;
      padding: {{ section.settings.image_padding_mobile }}px;
    }

    #shopify-section-{{ section.id }} .coops-related-products__image,
    #shopify-section-{{ section.id }} .coops-related-products__placeholder {
      height: {{ section.settings.image_inner_height_mobile }}px;
    }

    #shopify-section-{{ section.id }} .coops-related-products__info {
      padding: {{ section.settings.info_padding_top_mobile }}px {{ section.settings.info_padding_horizontal_mobile }}px {{ section.settings.info_padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<section
  class="coops-related-products"
  data-html
  {% if crp_source == 'recommendations' and product != blank %}
    data-product-recommendations
  {% endif %}
>
  <div class="coops-related-products__inner">
    {% if section.settings.heading != blank %}
      <h2 class="coops-related-products__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    {% if crp_products != blank %}
      <ul class="coops-related-products__grid">
        {% assign crp_rendered_count = 0 %}

        {% for related_product in crp_products %}
          {% if related_product.id == crp_current_product_id %}
            {% continue %}
          {% endif %}

          {% if crp_rendered_count >= crp_limit %}
            {% break %}
          {% endif %}

          {% assign crp_rendered_count = crp_rendered_count | plus: 1 %}

          {% liquid
            assign crp_image = related_product.featured_media.preview_image | default: related_product.featured_image
            assign crp_on_sale = false

            for variant in related_product.variants
              if variant.compare_at_price > variant.price
                assign crp_on_sale = true
                break
              endif
            endfor
          %}

          <li class="coops-related-products__card">
            <a class="coops-related-products__link" href="{{ related_product.url }}">
              <div class="coops-related-products__image-wrap">
                {% if crp_image != blank %}
                  <img
                    class="coops-related-products__image"
                    src="{{ crp_image | image_url: width: 600 }}"
                    srcset="
                      {{ crp_image | image_url: width: 300 }} 300w,
                      {{ crp_image | image_url: width: 450 }} 450w,
                      {{ crp_image | image_url: width: 600 }} 600w
                    "
                    sizes="(max-width: 719px) 50vw, (max-width: 1023px) 33vw, 25vw"
                    alt="{{ crp_image.alt | default: related_product.title | escape }}"
                    loading="lazy"
                    width="{{ crp_image.width }}"
                    height="{{ crp_image.height }}"
                  >
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'coops-related-products__placeholder' }}
                {% endif %}
              </div>

              <div class="coops-related-products__info">
                <h3 class="coops-related-products__title">
                  {{ related_product.title }}
                </h3>

                {% if section.settings.show_rating %}
                  <div
                    class="coops-related-products__rating"
                    data-bv-show="inline_rating"
                    data-bv-product-id="{{ related_product.id }}"
                    data-bv-redirect-url="{{ related_product.url }}"
                    data-bv-seo="false"
                  ></div>
                {% endif %}

                {% if section.settings.show_price %}
                  <div class="coops-related-products__price">
                    {% if crp_on_sale and related_product.compare_at_price > related_product.price %}
                      <span class="coops-related-products__compare-price">
                        {{ related_product.compare_at_price | money }}
                      </span>
                    {% endif %}

                    <span class="coops-related-products__current-price">
                      {% if related_product.price_varies %}
                        {{ related_product.price_min | money }} - {{ related_product.price_max | money }}
                      {% else %}
                        {{ related_product.price | money }}
                      {% endif %}
                    </span>
                  </div>
                {% endif %}
              </div>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>

{% schema %}
