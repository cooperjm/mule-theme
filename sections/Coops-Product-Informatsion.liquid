{% render 'breadcrumbs' %}

<section
  class="
    coops-product-information
    product__container
    product__container--two-columns
  "
  data-product-wrapper
>
  {%
    render 'product',
    is_product_modal: false,
    use_theme_gallery: true,
    show_dynamic_checkout_button: settings.show_dynamic_checkout_button,
    select_first_available_variant: settings.select_first_available_variant,
    gallery_aspect_ratio: section.settings.gallery_aspect_ratio,
    gallery_thumbnail_position: section.settings.gallery_thumbnail_position,
    gallery_image_crop: section.settings.gallery_image_crop,
    gallery_click_to_zoom: section.settings.gallery_click_to_zoom,
    gallery_hover_zoom: section.settings.gallery_hover_zoom
  %}
</section>

<script>
  (function() {
    var section = document.getElementById('shopify-section-{{ section.id }}');

    if (!section) {
      return;
    }

    function initializeReadMore() {
      var contents = section.querySelectorAll('[data-coops-tabs-content]');

      contents.forEach(function(content) {
        var button = content.parentNode.querySelector('[data-coops-tabs-read-more]');

        if (!button) {
          return;
        }

        var collapsedHeight = parseInt(content.getAttribute('data-collapsed-height'), 10);

        if (!collapsedHeight || content.scrollHeight <= collapsedHeight) {
          button.hidden = true;
          return;
        }

        content.style.maxHeight = collapsedHeight + 'px';
        content.classList.add('is-collapsed');
        button.hidden = false;

        button.addEventListener('click', function() {
          var isCollapsed = content.classList.toggle('is-collapsed');

          if (isCollapsed) {
            content.style.maxHeight = collapsedHeight + 'px';
            button.textContent = button.getAttribute('data-read-more-text');
          } else {
            content.style.maxHeight = '';
            button.textContent = button.getAttribute('data-read-less-text');
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeReadMore);
    } else {
      initializeReadMore();
    }
  })();
</script>

