{% if cart.items.size > 0 %}
  {% assign has_items = true %}
{% endif %}

{% if has_items %}

  {{ 'cart-total-with-logos.css' | asset_url | stylesheet_tag }}

  <div class="
    cart-total-with-logos__{{ section.id }}
    cart-total-with-logos__container"
  >
    <div class="cart-total-with-logos__content">
      {% for block in section.blocks %}
        {% if block.settings.text != blank or block.settings.title != blank %}
          <div
            class="cart-total-with-logos__block"
            {{ block.shopify_attributes }}
            data-highlights-block
          >
            {% if block.settings.icon != 'none' or block.settings.image != blank %}
              <div class="cart-total-with-logos__icon">
                {% if block.settings.image != blank %}
                  {%
                    render 'rimg',
                    class: 'cart-total-with-logos__custom-icon',
                    img: block.settings.image,
                    size: '150x',
                    focal_point: block.settings.image.presentation.focal_point,
                  %}
                {% else %}
                  {% render 'icon-library', id: block.settings.icon %}
                {% endif %}
              </div>
            {% endif %}

            <div class="cart-total-with-logos__text">
              {% if block.settings.title != blank %}
                <span class="cart-total-with-logos__heading">
                  {{ block.settings.title | escape }}
                </span>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="cart-total-with-logos__description">
                  {{ block.settings.text }}
                </div>
              {% endif %}
            </div>
            {% if block.settings.link != blank %}
              <a
                class="cart-total-with-logos__block-link"
                href="{{ block.settings.link }}"
                {{ block.shopify_attributes }}
              >
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="cart-total-block">
      <div class="cart-subtotal">
        <span>{{ 'cart.general.subtotal' | t }}:</span>
        <span class="money" data-cart-total>{{ cart.items_subtotal_price | money }}</span>
      </div>
      <ul class="discount-list" data-cart-discounts aria-label="{{ 'product.general.discounts' | t }}">
        {%- for discount_application in cart.cart_level_discount_applications -%}
          <li class="discount-list-item cart-discount">
            <span class="cart-discount-title">
              Promo Code: <em>{{ discount_application.title }}</em>
            </span>
            <span class="cart-discount-price">-<span class="money">{{ discount_application.total_allocated_amount | money }}</span></span>
          </li>
        {%- endfor -%}
        
      </ul>

      <div class="cart-shipping">
        {%- capture taxes_shipping_checkout -%}
          {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
            {{ 'cart.general.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
          {%- elsif cart.taxes_included -%}
            {{ 'cart.general.taxes_included_but_shipping_at_checkout' | t }}
          {%- elsif shop.shipping_policy.body != blank -%}
            {{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
          {%- else -%}
            {{ 'cart.general.tax_and_shipping' | t }}
          {%- endif -%}
        {%- endcapture -%}

        <p class="cart-message meta"><em>{{ taxes_shipping_checkout }}</em></p>
      </div>

      <div class="cart-total">
        <span>Cart Total:</span>
        <span class="money" data-cart-total>{{ cart.total_price | money }}</span>
      </div>

      <div class="cart-checkout">
        <button
          class="button-primary"
          type="submit"
          name="checkout"
          aria-label="{{ 'cart.general.checkout' | t }}"
        >
          {{ 'cart.general.checkout' | t }}
          {% render 'icon-checkout-lock' %}
        </button>
      </div>
    </div>
  </div>
{% endif %}
