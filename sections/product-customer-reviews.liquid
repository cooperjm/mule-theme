
<section id="product-customer-reviews">
    <h2>{{ section.settings.customer_reviews_heading }}</h2>
    <div class="product-customer-reviews-container product-template-container">
      <div class="reviews-slider">
        {% for block in section.blocks %}
          <div class="product-customer-reviews-box">
            <div class="product-customer-reviews-box-img">
                <img src="{{ block.settings.review_image | image_url }}"/>
            </div>
            <div class="product-customer-reviews-box-text">
              <p class="product-customer-reviews-name">{{ block.settings.customer_username }}</p>
              <p>⭐⭐⭐⭐⭐</p>
              <p>{{ block.settings.customer_review_text }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
      {% if section.settings.show_customer_reviews_readmore == true %}
      <div class="open-reviews">
        <button class="open-reviews-cta">Read More</button>
      </div>
      {% endif %}
    </div>
</section>

{%  style  %}

/* Customer Reviews */

#product-customer-reviews {
    position: relative;
    background-color: #FFF;
    padding: 100px 20px 50px;
    display: flex;
    gap: 40px;
    flex-direction: column;
    background-color: #f4f4f4;
}

.template-product #product-customer-reviews {
  z-index: 5;
  padding-bottom: 0;
}

#product-customer-reviews .reviews-slider {
    max-width: 1500px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    align-items: center;
    width: 100%;
}

#product-customer-reviews h2{
    color: #181818;
    text-align: center;
    font-size: 34px;
    font-weight: 700;
    text-transform: capitalize;
    margin: 0px;
}

#product-customer-reviews .product-customer-reviews-box {
    display: flex;
    min-height: 240px;
    width: calc((100% / 3) - (40px / 3));
}

#product-customer-reviews .product-customer-reviews-box-text {
    background: #282829;
    padding: 10px 15px;
    border-radius: 0px 4px 4px 0px;
    width: 50%;
}

#product-customer-reviews .product-customer-reviews-box-text p {
    color: #fff;
    font-size: 14px;
    font-weight: 400;
    line-height: normal;
    margin: 10px 0px 5px;
}

#product-customer-reviews .product-customer-reviews-cta {
    border-radius: 4px;
    font-family: "Roboto Condensed", sans-serif;
    border: 1px solid #181818;
    background: rgba(24, 24, 24, 0.00);
    box-shadow: 0px 1px 4px 0px rgba(0, 0, 0, 0.10);
    padding: 10px 40px;
    color: #181818;
    font-size: 18px;
    font-weight: 700;
    line-height: normal;
}

#product-customer-reviews p.product-customer-reviews-name {
    color: #fff;
    font-family: "Roboto Condensed", sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: normal;
}

#product-customer-reviews .product-customer-reviews-box-img {
  width: 50%;
}

#product-customer-reviews .product-customer-reviews-box-img img {
    display: block;
    border-bottom-left-radius: 4px;
    border-top-left-radius: 4px;
    width: 100%;
    height: 100%;
}

@media (max-width: 1219px) {
    #product-customer-reviews .product-customer-reviews-box {
      flex-direction: column;
    }

    #product-customer-reviews .product-customer-reviews-box-img {
      width: 100%;
    }

    #product-customer-reviews .product-customer-reviews-box-img img {
      border-radius: 4px 4px 0px 0px;
      height: 300px;
      object-fit: cover;
    }

    #product-customer-reviews .product-customer-reviews-box-text {
      border-radius: 0px 0px 4px 4px;
      width: 100%;
      margin-top: -5px;
      min-height: 220px;
    }
}

@media (max-width: 768px) {
  #product-customer-reviews .product-customer-reviews-box-text {
    text-align: center;
  }
}

.product-customer-reviews-container .slick-next, .product-customer-reviews-container .slick-prev  {
  top: unset;
}

.open-reviews {
  text-align: center;
  margin: auto;
  padding: 30px;
}

.open-reviews-cta {
  border-radius: 4px;
  border: 1px solid #181818;
  background: #18181800;
  box-shadow: 0 1px 4px #0000001a;
  padding: 10px 40px;
  color: #181818;
  font-size: 18px;
  font-weight: 700;
  line-height: normal;
  cursor: pointer;
}

.open-reviews-cta:hover {
  background: #000000;
  color: #ffffff;
}

div[data-bv-show="reviews"] {
  display: none;
}

.product-customer-reviews--section + .shopify-section .product-section--container {
  margin-top: 0;
}

{% endstyle %}


<script>
setTimeout(function() {

    var reviewsBlock = document.querySelector('div[data-bv-show="reviews"]');

    if (reviewsBlock) {

        var openReviewsBtn = document.querySelector('.open-reviews-cta');

        if (openReviewsBtn) {

            openReviewsBtn.addEventListener('click', function() {

                if (reviewsBlock.style.display === 'block') {
                    reviewsBlock.style.display = 'none';
                } else {
                    reviewsBlock.style.display = 'block';
                }
            });
        } else {
            console.warn('No open-reviews-cta found');
        }
    } else {
        console.warn('No "shopify-block-bazaarvoice_reviews_photos_reviews_block_nRywgj" found');
    }
}, 2000);

</script>

{% schema %}
{
  "name": "Product Customer Reviews",
  "class": "product-customer-reviews--section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "customer_reviews_heading",
      "label": "Customer Reviews heading",
      "default": "Customer Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_customer_reviews_readmore",
      "label": "Show Read More",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "customer_review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "text",
          "id": "customer_username",
          "label": "Customer Username"
        },
        {
          "type": "image_picker",
          "id": "review_image",
          "label": "Review Image"
        },
        {
          "type": "textarea",
          "id": "customer_review_text",
          "label": "Customer Review Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Customer Reviews"
    }
  ]
}

{% endschema %}