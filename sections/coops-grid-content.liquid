{% style %}
  /* ── Section Padding ── */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ── Grid Wrapper ── */
  .coops-grid-content-{{ section.id }} {
    {% if section.settings.full_width %}
      max-width: 100%;
      padding-left: 0;
      padding-right: 0;
    {% else %}
      max-width: var(--page-width, 1200px);
      margin: 0 auto;
      padding-left: 2rem;
      padding-right: 2rem;
    {% endif %}
  }

  .coops-grid-content-{{ section.id }} .coops-grid-content__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.grid_gap }}px;
  }

  @media screen and (min-width: 750px) {
    .coops-grid-content-{{ section.id }} .coops-grid-content__grid {
      grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    }
  }

  /* ── Block Card ── */
  .coops-grid-content-{{ section.id }} .coops-grid-content__card {
    display: flex;
  }

  .coops-grid-content-{{ section.id }} .coops-grid-content__card-inner {
    text-align: left;
  }

  /* ── Icon ── */
  .coops-grid-content-{{ section.id }} .coops-grid-content__icon {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    margin-bottom: 20px;
  }

  .coops-grid-content-{{ section.id }} .coops-grid-content__icon img,
  .coops-grid-content-{{ section.id }} .coops-grid-content__icon svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── Heading ── */
  .coops-grid-content-{{ section.id }} .coops-grid-content__heading {
    margin: 0 0 16px 0;
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* ── Body Richtext ── */
  .coops-grid-content-{{ section.id }} .coops-grid-content__body {
    line-height: 1.6;
    margin: 0;
  }

  .coops-grid-content-{{ section.id }} .coops-grid-content__body h1,
  .coops-grid-content-{{ section.id }} .coops-grid-content__body h2,
  .coops-grid-content-{{ section.id }} .coops-grid-content__body h3,
  .coops-grid-content-{{ section.id }} .coops-grid-content__body h4,
  .coops-grid-content-{{ section.id }} .coops-grid-content__body h5,
  .coops-grid-content-{{ section.id }} .coops-grid-content__body h6,
  .coops-grid-content-{{ section.id }} .coops-grid-content__body p {
    margin: 0 0 8px 0;
  }

  /* ── Custom Bullet Lists ── */
  .coops-grid-content-{{ section.id }} .coops-grid-content__body ul,
  .coops-grid-content-{{ section.id }} .coops-grid-content__body ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .coops-grid-content-{{ section.id }} .coops-grid-content__body li {
    position: relative;
    padding-left: 30px;
    margin-bottom: 12px;
    line-height: 1.5;
  }

  .coops-grid-content-{{ section.id }} .coops-grid-content__body li .coops-grid-bullet-icon {
    position: absolute;
    left: 0;
    top: 3px;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .coops-grid-content-{{ section.id }} .coops-grid-content__body li .coops-grid-bullet-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
{% endstyle %}

<div class="coops-grid-content-{{ section.id }} section-{{ section.id }}-padding">
  <div class="coops-grid-content__grid">
    {% for block in section.blocks %}
      <div
        class="coops-grid-content__card"
        style="
          background-color: {{ block.settings.background_color }};
          padding: {{ block.settings.block_padding }}px;
          justify-content: {{ block.settings.content_alignment }};
        "
        {{ block.shopify_attributes }}
      >
        <div class="coops-grid-content__card-inner" style="max-width: {{ block.settings.content_width }}%;">
        {%- comment -%} Icon {%- endcomment -%}
        {% if block.settings.svg_code != blank or block.settings.icon_image != blank %}
          <div class="coops-grid-content__icon" style="width: {{ block.settings.icon_width }}px;">
            {% if block.settings.svg_code != blank %}
              {{ block.settings.svg_code }}
            {% elsif block.settings.icon_image != blank %}
              {{
                block.settings.icon_image
                | image_url: width: 200
                | image_tag: loading: 'lazy', alt: block.settings.icon_image.alt | default: block.settings.heading
              }}
            {% endif %}
          </div>
        {% endif %}

        {%- comment -%} Heading {%- endcomment -%}
        {% if block.settings.heading != blank %}
          <h3
            class="coops-grid-content__heading"
            style="
              color: {{ block.settings.heading_color }};
              font-size: {{ block.settings.heading_size }}px;
              font-weight: {{ block.settings.heading_weight }};
            "
          >
            {{ block.settings.heading | escape }}
          </h3>
        {% endif %}

        {%- comment -%} Body Richtext {%- endcomment -%}
        {% if block.settings.body_content != blank %}
          {% capture bullet_icon %}
            <span class="coops-grid-bullet-icon" style="width: {{ block.settings.checkmark_size }}px; height: {{ block.settings.checkmark_size }}px;">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10240 10240">
                <g fill="{{ block.settings.background_color }}"><path d="M0 7665 l0 -2575 23 0 c22 0 934 908 3945 3930 l1151 1155 2523 -2523 c2276 -2275 2527 -2523 2561 -2529 l37 -6 0 2562 0 2561 -5120 0 -5120 0 0 -2575z"/><path d="M3254 7118 c-1004 -1003 -1865 -1863 -1915 -1912 -75 -76 -89 -95 -89 -122 0 -30 127 -158 1598 -1616 878 -871 1738 -1722 1909 -1891 l312 -308 69 3 69 3 1067 1061 c1003 999 1066 1063 1066 1096 0 30 -11 45 -87 119 -226 218 -1368 1325 -1793 1738 -457 444 -476 461 -512 461 -37 0 -56 -17 -636 -594 l-597 -594 -75 71 c-41 39 -155 149 -252 245 -144 141 -176 177 -169 190 6 9 401 408 878 885 l869 868 390 -378 c656 -636 1364 -1323 1904 -1849 656 -638 598 -586 653 -582 44 3 47 6 566 520 488 484 521 519 521 551 0 33 -61 96 -1062 1095 -585 583 -1447 1442 -1917 1908 -853 849 -853 849 -897 852 l-45 3 -1825 -1823z"/><path d="M0 2540 l0 -2540 2560 0 c2112 0 2560 2 2560 13 0 7 -78 90 -172 183 -95 93 -209 205 -253 249 -45 44 -375 372 -735 730 -360 357 -1389 1382 -2286 2277 -1162 1161 -1637 1628 -1652 1628 l-22 0 0 -2540z"/><path d="M9820 4703 c-201 -201 -573 -573 -827 -826 -490 -488 -486 -484 -445 -533 17 -21 870 -849 1265 -1229 l198 -189 -263 -263 -262 -262 -141 137 c-375 365 -1195 1156 -1281 1235 -95 88 65 230 -1507 -1336 -1181 -1176 -1388 -1386 -1387 -1409 l0 -28 2535 0 2535 0 0 2535 0 2535 -27 -1 c-23 -1 -96 -69 -393 -366z"/></g>
                <g fill="{{ block.settings.diamond_color }}"><path d="M3946 9058 c-2169 -2177 -3931 -3938 -3938 -3938 -5 0 -8 -13 -8 -28 0 -25 229 -257 1637 -1663 901 -899 1933 -1927 2293 -2284 360 -358 682 -677 715 -711 33 -33 146 -145 251 -247 l192 -187 61 0 c45 0 60 3 55 12 -5 7 497 514 1382 1395 1180 1175 1392 1382 1407 1373 14 -9 17 -6 17 19 0 25 -44 71 -331 345 -284 271 -336 316 -361 316 -26 0 -29 -2 -18 -15 11 -13 -149 -176 -1055 -1078 -1016 -1011 -1070 -1062 -1107 -1065 -38 -3 -40 -2 -351 305 -467 461 -3383 3352 -3450 3420 l-57 59 89 89 c2809 2807 3743 3736 3755 3733 8 -2 398 -385 868 -852 1331 -1324 2978 -2968 2978 -2973 0 -10 -1043 -1038 -1057 -1041 -8 -2 -20 2 -28 8 -13 10 -15 8 -15 -17 0 -26 42 -71 324 -346 293 -286 327 -317 357 -317 22 0 30 3 23 10 -10 10 128 148 1304 1319 l362 360 0 45 c0 39 -3 46 -23 51 -13 4 -1139 1122 -2553 2536 -1391 1391 -2536 2529 -2544 2529 -8 0 -537 -523 -1174 -1162z"/></g>
                <g fill="{{ block.settings.checkmark_color }}"><path d="M4051 5966 c-679 -680 -901 -908 -895 -918 18 -31 550 -538 561 -536 6 2 284 274 617 606 333 331 609 602 614 602 4 0 221 -208 482 -461 1125 -1094 1717 -1666 2040 -1974 190 -180 404 -385 475 -454 72 -70 242 -234 380 -366 301 -289 793 -765 1001 -967 83 -82 155 -148 160 -148 5 0 139 130 297 288 l288 288 -218 210 c-332 319 -1223 1184 -1448 1404 -110 108 -353 345 -540 526 -187 181 -508 493 -715 694 -366 357 -968 942 -1774 1723 -220 213 -405 387 -411 387 -6 0 -417 -407 -914 -904z"/></g>
              </svg>
            </span>
          {% endcapture %}

          <div
            class="coops-grid-content__body"
            style="
              color: {{ block.settings.body_color }};
              font-size: {{ block.settings.body_size }}px;
            "
          >
            {% if block.settings.show_bullet_icons %}
              {%- comment -%} Split on <li> and re-inject with bullet icon SVG {%- endcomment -%}
              {% assign bullet_pad = block.settings.checkmark_size | plus: 10 %}
              {% assign body_parts = block.settings.body_content | split: '<li>' %}
              {% capture rendered_body %}
                {% for part in body_parts %}
                  {% if forloop.first %}
                    {{ part }}
                  {% else %}
                    <li style="padding-left: {{ bullet_pad }}px;">{{ bullet_icon }}{{ part }}
                  {% endif %}
                {% endfor %}
              {% endcapture %}
              {{ rendered_body }}
            {% else %}
              {{ block.settings.body_content }}
            {% endif %}
          </div>
        {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Coop's Grid Content",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Grid Gap",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width",
      "default": false,
      "info": "Remove the max-width constraint so the grid spans the full page width."
    }
  ],
  "blocks": [
    {
      "type": "grid_block",
      "name": "Grid Block",
      "settings": [
        {
          "type": "header",
          "content": "Icon"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image"
        },
        {
          "type": "html",
          "id": "svg_code",
          "label": "Or SVG Code",
          "info": "Paste SVG code here. Overrides image picker."
        },
        {
          "type": "range",
          "id": "icon_width",
          "min": 20,
          "max": 200,
          "step": 5,
          "unit": "px",
          "label": "Icon Width",
          "default": 60
        },
        {
          "type": "header",
          "content": "Heading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading Color",
          "default": "#ffffff"
        },
        {
          "type": "range",
          "id": "heading_size",
          "min": 16,
          "max": 60,
          "step": 1,
          "unit": "px",
          "label": "Heading Size",
          "default": 28
        },
        {
          "type": "select",
          "id": "heading_weight",
          "label": "Heading Weight",
          "options": [
            { "value": "400", "label": "Normal" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semi-Bold" },
            { "value": "700", "label": "Bold" },
            { "value": "800", "label": "Extra Bold" },
            { "value": "900", "label": "Black" }
          ],
          "default": "800"
        },
        {
          "type": "header",
          "content": "Body Content"
        },
        {
          "type": "richtext",
          "id": "body_content",
          "label": "Body Content",
          "info": "Use bullet lists for checkmark items. Supports bold, italic, and links."
        },
        {
          "type": "color",
          "id": "body_color",
          "label": "Body Text Color",
          "default": "#ffffff"
        },
        {
          "type": "range",
          "id": "body_size",
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px",
          "label": "Body Font Size",
          "default": 15
        },
        {
          "type": "header",
          "content": "Bullet Icon"
        },
        {
          "type": "checkbox",
          "id": "show_bullet_icons",
          "label": "Show Checkmark Bullet Icons",
          "default": true,
          "info": "Replace default list bullets with the diamond checkmark SVG."
        },
        {
          "type": "color",
          "id": "diamond_color",
          "label": "Diamond Color",
          "default": "#FDBF06",
          "info": "Color of the diamond shape behind the checkmark."
        },
        {
          "type": "color",
          "id": "checkmark_color",
          "label": "Checkmark Color",
          "default": "#000000",
          "info": "Color of the checkmark itself."
        },
        {
          "type": "range",
          "id": "checkmark_size",
          "min": 12,
          "max": 40,
          "step": 1,
          "unit": "px",
          "label": "Checkmark Size",
          "default": 18
        },
        {
          "type": "header",
          "content": "Card Styling"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "block_padding",
          "min": 10,
          "max": 80,
          "step": 2,
          "unit": "px",
          "label": "Block Padding",
          "default": 40
        },
        {
          "type": "header",
          "content": "Content Layout"
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Content Alignment",
          "options": [
            { "value": "flex-start", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "flex-end", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "range",
          "id": "content_width",
          "min": 30,
          "max": 100,
          "step": 5,
          "unit": "%",
          "label": "Content Width",
          "default": 80,
          "info": "Width of the content area inside the card."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coop's Grid Content",
      "blocks": [
        {
          "type": "grid_block",
          "settings": {
            "heading": "THE POWER TO MOVE YOU.",
            "background_color": "#000000",
            "heading_color": "#ffffff",
            "body_color": "#ffffff",
            "checkmark_color": "#FDBF06"
          }
        },
        {
          "type": "grid_block",
          "settings": {
            "heading": "EASY INSTALLATION.",
            "background_color": "#ffffff",
            "heading_color": "#000000",
            "body_color": "#000000",
            "checkmark_color": "#FDBF06"
          }
        },
        {
          "type": "grid_block",
          "settings": {
            "heading": "QUIET OPERATION.",
            "background_color": "#000000",
            "heading_color": "#ffffff",
            "body_color": "#ffffff",
            "checkmark_color": "#FDBF06"
          }
        },
        {
          "type": "grid_block",
          "settings": {
            "heading": "EASY... WELL, EVERYTHING.",
            "background_color": "#ffffff",
            "heading_color": "#000000",
            "body_color": "#000000",
            "checkmark_color": "#FDBF06"
          }
        }
      ]
    }
  ]
}
{% endschema %}
