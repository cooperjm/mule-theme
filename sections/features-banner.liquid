      "default": "At the Gym"
    },
    {
      "type": "text",
      "id": "icon2_alt",
      "label": "Icon 2 Alt Text"
    },
    {
      "type": "image_picker",
      "id": "icon3_image",
      "label": "Icon 3 Image"
    },
    {
      "type": "text",
      "id": "icon3_text",
      "label": "Icon 3 Text",
      "default": "At the Barn"
    },
    {
      "type": "text",
      "id": "icon3_alt",
      "label": "Icon 3 Alt Text"
    },
    {
      "type": "image_picker",
      "id": "icon4_image",
      "label": "Icon 4 Image"
    },
    {
      "type": "text",
