{%- comment -%} Coops Slider — self-contained section with no theme JS dependencies {%- endcomment -%}

{% liquid
  assign autoplay = section.settings.enable_autoplay
  assign autoplay_speed = section.settings.autoplay_speed
  assign transition = section.settings.transition
  assign show_arrows = section.settings.show_arrows
  assign show_dots = section.settings.show_dots
  assign dot_style = section.settings.dot_style

  case section.settings.desktop_height
    when 'small'
      assign desktop_h = '400px'
    when 'medium'
      assign desktop_h = '560px'
    when 'large'
      assign desktop_h = '720px'
    when 'viewport'
      assign desktop_h = '100vh'
    when 'custom'
      assign desktop_h = section.settings.desktop_height_custom | append: 'px'
  endcase

  case section.settings.mobile_height
    when 'small'
      assign mobile_h = '280px'
    when 'medium'
      assign mobile_h = '420px'
    when 'large'
      assign mobile_h = '560px'
    when 'viewport'
      assign mobile_h = '100vh'
    when 'custom'
      assign mobile_h = section.settings.mobile_height_custom | append: 'px'
  endcase
%}

<style>
  :root {
    --mhs-desktop-h: {{ desktop_h }};
    --mhs-mobile-h: {{ mobile_h }};
    --mhs-transition-speed: 0.55s;
    --mhs-fade-speed: 0.6s;
    --mhs-overlay-color: #000;
  }

  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .mhs {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: var(--mhs-desktop-h);
    background: #111;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .mhs {
      height: var(--mhs-mobile-h);
    }
  }

  /* ── Track (slide mode) ──────────────────────────────── */
  #shopify-section-{{ section.id }} .mhs__track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform var(--mhs-transition-speed) cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  /* ── Slide ───────────────────────────────────────────── */
  #shopify-section-{{ section.id }} .mhs__slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  /* ── Track (absolute modes) ───────────────────────────── */
  #shopify-section-{{ section.id }} .mhs__track--absolute {
    display: block;
    position: relative;
  }

  #shopify-section-{{ section.id }} .mhs__track--absolute .mhs__slide {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .mhs__track--absolute .mhs__slide.is-leaving {
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .mhs__track--absolute .mhs__slide.is-active {
    pointer-events: auto;
    z-index: 3;
  }

  /* Fade */
  #shopify-section-{{ section.id }} .mhs__track--fade .mhs__slide {
    opacity: 0;
    transition: opacity var(--mhs-fade-speed) ease;
  }
  #shopify-section-{{ section.id }} .mhs__track--fade .mhs__slide.is-leaving {
    opacity: 0;
  }
  #shopify-section-{{ section.id }} .mhs__track--fade .mhs__slide.is-active {
    opacity: 1;
  }

  /* Scale */
  #shopify-section-{{ section.id }} .mhs__track--scale .mhs__slide {
    opacity: 0;
    transform: scale(1.05);
    transition: opacity var(--mhs-fade-speed) ease, transform var(--mhs-fade-speed) ease;
  }
  #shopify-section-{{ section.id }} .mhs__track--scale .mhs__slide.is-leaving {
    opacity: 0;
    transform: scale(0.95);
  }
  #shopify-section-{{ section.id }} .mhs__track--scale .mhs__slide.is-active {
    opacity: 1;
    transform: scale(1);
  }

  /* Reveal */
  #shopify-section-{{ section.id }} .mhs__track--reveal .mhs__slide {
    transform: translateX(100%);
    transition: transform var(--mhs-transition-speed) cubic-bezier(0.4, 0, 0.2, 1);
  }
  #shopify-section-{{ section.id }} .mhs__track--reveal .mhs__slide.is-leaving {
    transform: translateX(0);
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .mhs__track--reveal .mhs__slide.is-active {
    transform: translateX(0);
    z-index: 2;
  }

  /* Parallax */
  #shopify-section-{{ section.id }} .mhs__track--parallax .mhs__slide {
    transform: translateX(100%);
    transition: transform var(--mhs-transition-speed) cubic-bezier(0.4, 0, 0.2, 1);
  }
  #shopify-section-{{ section.id }} .mhs__track--parallax .mhs__slide.is-leaving {
    transform: translateX(-30%);
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .mhs__track--parallax .mhs__slide.is-active {
    transform: translateX(0);
    z-index: 2;
  }

  /* ── Background image ────────────────────────────────── */
  #shopify-section-{{ section.id }} .mhs__bg-item {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: var(--mhs-bg-fit, cover);
    object-position: var(--mhs-bg-pos, center);
    transition: transform 8s ease-out;
    z-index: 1;
  }

  /* Ken Burns Effect */
  #shopify-section-{{ section.id }} .mhs__slide.is-active .mhs__bg-item--ken-burns {
    transform: scale(1.15) translateZ(0);
  }

  #shopify-section-{{ section.id }} .mhs__bg-mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .mhs__slide--has-mobile-img .mhs__bg-desktop {
      display: none;
    }
    #shopify-section-{{ section.id }} .mhs__bg-mobile {
      display: block;
    }
  }

  /* ── Overlay ─────────────────────────────────────────── */
  #shopify-section-{{ section.id }} .mhs__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .mhs__overlay--gradient-bottom {
    background: linear-gradient(to top, var(--mhs-overlay-color) 0%, transparent 75%) !important;
    opacity: 1 !important;
  }
  #shopify-section-{{ section.id }} .mhs__overlay--gradient-top {
    background: linear-gradient(to bottom, var(--mhs-overlay-color) 0%, transparent 75%) !important;
    opacity: 1 !important;
  }
  #shopify-section-{{ section.id }} .mhs__overlay--gradient-left {
    background: linear-gradient(to right, var(--mhs-overlay-color) 0%, transparent 75%) !important;
    opacity: 1 !important;
  }
  #shopify-section-{{ section.id }} .mhs__overlay--gradient-right {
    background: linear-gradient(to left, var(--mhs-overlay-color) 0%, transparent 75%) !important;
    opacity: 1 !important;
  }

  /* Whole slide link */
  #shopify-section-{{ section.id }} .mhs__slide-link {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: transparent;
  }

  /* ── Content wrapper ─────────────────────────────────── */
  #shopify-section-{{ section.id }} .mhs__content {
    position: absolute;
    inset: 0;
    display: flex;
    padding: {{ section.settings.content_padding }}px;
    z-index: 3;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .mhs__content {
      padding: 24px 20px;
    }
  }

  /* Horizontal */
  #shopify-section-{{ section.id }} .mhs__content--h-left   { justify-content: flex-start; }
  #shopify-section-{{ section.id }} .mhs__content--h-center { justify-content: center; }
  #shopify-section-{{ section.id }} .mhs__content--h-right  { justify-content: flex-end; }

  /* Vertical */
  #shopify-section-{{ section.id }} .mhs__content--v-top    { align-items: flex-start; }
  #shopify-section-{{ section.id }} .mhs__content--v-middle { align-items: center; }
  #shopify-section-{{ section.id }} .mhs__content--v-bottom { align-items: flex-end; }

  #shopify-section-{{ section.id }} .mhs__content-inner {
    width: 100%;
  }

  /* ── Content Animations ──────────────────────────────── */
  /* Hidden starting states */
  #shopify-section-{{ section.id }} .mhs__content-inner--anim-fade-up > * {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity var(--anim-speed, 0.8s) ease, transform var(--anim-speed, 0.8s) ease;
    transition-delay: var(--anim-delay, 0s);
  }
  #shopify-section-{{ section.id }} .mhs__content-inner--anim-fade-down > * {
    opacity: 0;
    transform: translateY(-30px);
    transition: opacity var(--anim-speed, 0.8s) ease, transform var(--anim-speed, 0.8s) ease;
    transition-delay: var(--anim-delay, 0s);
  }
  #shopify-section-{{ section.id }} .mhs__content-inner--anim-fade-left > * {
    opacity: 0;
    transform: translateX(30px);
    transition: opacity var(--anim-speed, 0.8s) ease, transform var(--anim-speed, 0.8s) ease;
    transition-delay: var(--anim-delay, 0s);
  }
  #shopify-section-{{ section.id }} .mhs__content-inner--anim-fade-right > * {
    opacity: 0;
    transform: translateX(-30px);
    transition: opacity var(--anim-speed, 0.8s) ease, transform var(--anim-speed, 0.8s) ease;
    transition-delay: var(--anim-delay, 0s);
  }
  #shopify-section-{{ section.id }} .mhs__content-inner--anim-zoom-in > * {
    opacity: 0;
    transform: scale(0.9);
    transition: opacity var(--anim-speed, 0.8s) ease, transform var(--anim-speed, 0.8s) ease;
    transition-delay: var(--anim-delay, 0s);
  }

  /* Active states (triggers the transition) */
  #shopify-section-{{ section.id }} .mhs__slide.is-active .mhs__content-inner[class*="--anim-"] > *,
  #shopify-section-{{ section.id }} .mhs__slide.is-leaving .mhs__content-inner[class*="--anim-"] > * {
    opacity: 1;
    transform: none;
  }

  /* Content Background Styles */
  #shopify-section-{{ section.id }} .mhs__content-inner--bg-glassmorphism {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 40px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
  }

  #shopify-section-{{ section.id }} .mhs__content-inner--bg-solid {
    background: var(--mhs-bg-solid, rgba(0,0,0,0.5));
    padding: 40px;
    border-radius: 12px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .mhs__content-inner--bg-glassmorphism,
    #shopify-section-{{ section.id }} .mhs__content-inner--bg-solid {
      padding: 32px 24px;
    }
  }

  /* Text Shadows */
  #shopify-section-{{ section.id }} .mhs__shadow-soft { filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3)); }
  #shopify-section-{{ section.id }} .mhs__shadow-medium { filter: drop-shadow(0 4px 8px rgba(0,0,0,0.5)); }
  #shopify-section-{{ section.id }} .mhs__shadow-strong { filter: drop-shadow(0 6px 16px rgba(0,0,0,0.85)); }

  /* Text alignment */
  #shopify-section-{{ section.id }} .mhs__content--ta-left  .mhs__content-inner { text-align: left; }
  #shopify-section-{{ section.id }} .mhs__content--ta-center .mhs__content-inner { text-align: center; }
  #shopify-section-{{ section.id }} .mhs__content--ta-right .mhs__content-inner { text-align: right; }

  #shopify-section-{{ section.id }} .mhs__content--ta-center .mhs__buttons { justify-content: center; }
  #shopify-section-{{ section.id }} .mhs__content--ta-right .mhs__buttons  { justify-content: flex-end; }

  /* ── Typography ──────────────────────────────────────── */
  #shopify-section-{{ section.id }} .mhs__eyebrow {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 14px;
    opacity: 0.75;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .mhs__eyebrow--badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border-radius: 4px;
    background-color: var(--badge-bg, #fff);
    color: var(--badge-color, #000);
    opacity: 1;
    margin: 0 0 18px;
  }

  #shopify-section-{{ section.id }} .mhs__headline {
    font-size: clamp(28px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.05;
    margin: 0 0 16px;
    text-wrap: balance;
  }

  #shopify-section-{{ section.id }} .mhs__subheading {
    font-size: clamp(14px, 1.6vw, 18px);
    line-height: 1.6;
    margin: 0 0 28px;
    opacity: 0.88;
  }

  #shopify-section-{{ section.id }} .mhs__subheading p { margin: 0; }

  /* ── Buttons ─────────────────────────────────────────── */
  #shopify-section-{{ section.id }} .mhs__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .mhs__btn {
    display: inline-block;
    padding: 13px 30px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    border: 2px solid transparent;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.15s ease;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .mhs__btn:hover {
    opacity: 0.82;
    transform: translateY(-2px);
  }

  #shopify-section-{{ section.id }} .mhs__btn--text {
    padding: 13px 0;
    border: none;
    background: transparent !important;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  /* ── Arrows ──────────────────────────────────────────── */
  #shopify-section-{{ section.id }} .mhs__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(0, 0, 0, 0.3);
    border: none;
    cursor: pointer;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
    color: {{ section.settings.arrow_color }};
  }

  #shopify-section-{{ section.id }} .mhs__arrow:hover {
    background: rgba(0, 0, 0, 0.55);
  }

  #shopify-section-{{ section.id }} .mhs__arrow--prev { left: 16px; }
  #shopify-section-{{ section.id }} .mhs__arrow--next { right: 16px; }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .mhs__arrow {
      width: 40px;
      height: 40px;
    }
  }

  /* ── Dots ────────────────────────────────────────────── */
  #shopify-section-{{ section.id }} .mhs__dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 10;
  }

  #shopify-section-{{ section.id }} .mhs__dot {
    border: none;
    cursor: pointer;
    padding: 0;
    background: {{ section.settings.dot_inactive_color }};
    opacity: 0.5;
    transition: opacity 0.2s ease, width 0.2s ease, transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .mhs__dot.is-active {
    background: {{ section.settings.dot_active_color }};
    opacity: 1;
  }

  /* dot */
  #shopify-section-{{ section.id }} .mhs__dot--dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  #shopify-section-{{ section.id }} .mhs__dot--dot.is-active {
    transform: scale(1.4);
  }

  /* dash */
  #shopify-section-{{ section.id }} .mhs__dot--dash {
    width: 20px;
    height: 3px;
    border-radius: 2px;
  }
  #shopify-section-{{ section.id }} .mhs__dot--dash.is-active {
    width: 32px;
  }

  /* number */
  #shopify-section-{{ section.id }} .mhs__dot--number {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 700;
    color: {{ section.settings.dot_active_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.5;
  }
  #shopify-section-{{ section.id }} .mhs__dot--number.is-active {
    opacity: 1;
  }
</style>

<div
  class="mhs"
  data-mhs
  data-autoplay="{{ autoplay }}"
  data-autoplay-speed="{{ autoplay_speed }}"
  data-transition="{{ transition }}"
  tabindex="0"
  aria-label="Hero slideshow"
  aria-roledescription="carousel"
>
  <div class="mhs__track" data-mhs-track>
    {%- for block in section.blocks -%}
      {%- liquid
        assign has_mobile = false
        if block.settings.mobile_background_image != blank or block.settings.mobile_background_video != blank
          assign has_mobile = true
        endif

        assign overlay_opacity_val = block.settings.overlay_opacity | times: 0.01

        case block.settings.content_position_horizontal
          when 'left'
            assign hc = 'mhs__content--h-left'
          when 'right'
            assign hc = 'mhs__content--h-right'
          else
            assign hc = 'mhs__content--h-center'
        endcase

        case block.settings.content_position_vertical
          when 'top'
            assign vc = 'mhs__content--v-top'
          when 'bottom'
            assign vc = 'mhs__content--v-bottom'
          else
            assign vc = 'mhs__content--v-middle'
        endcase

        assign tac = 'mhs__content--ta-' | append: block.settings.text_alignment

        assign btn1_style = block.settings.button_one_style
        assign btn2_style = block.settings.button_two_style

        assign btn1_bg = block.settings.button_one_color
        assign btn1_text = block.settings.button_one_text_color
        assign btn2_bg = block.settings.button_two_color
        assign btn2_text = block.settings.button_two_text_color

        if btn1_bg == 'rgba(0,0,0,0)'
          assign btn1_bg = settings.color_button_background
        endif
        if btn1_text == 'rgba(0,0,0,0)'
          assign btn1_text = settings.color_button_text
        endif
        if btn2_bg == 'rgba(0,0,0,0)'
          assign btn2_bg = settings.color_button_secondary_background
        endif
        if btn2_text == 'rgba(0,0,0,0)'
          assign btn2_text = settings.color_button_secondary_text
        endif
      -%}

      <div
        class="mhs__slide{% if has_mobile %} mhs__slide--has-mobile-img{% endif %}{% if forloop.first %} is-active{% endif %}"
        data-mhs-slide
        data-slide-index="{{ forloop.index0 }}"
        style="background-color: {{ block.settings.slide_background_color }};"
        aria-roledescription="slide"
        aria-label="Slide {{ forloop.index }} of {{ section.blocks.size }}"
        {{ block.shopify_attributes }}
      >
        {%- liquid
          assign fetch_priority = 'auto'
          assign loading_strat = 'lazy'
          if forloop.first
            assign fetch_priority = 'high'
            assign loading_strat = 'eager'
          endif

          assign ken_burns = ''
          if block.settings.enable_ken_burns
            assign ken_burns = ' mhs__bg-item--ken-burns'
          endif
        -%}

        {%- liquid
          assign desktop_class = 'mhs__bg-item mhs__bg-desktop' | append: ken_burns
          assign desktop_style = '--mhs-bg-pos: ' | append: block.settings.image_position | append: '; --mhs-bg-fit: ' | append: block.settings.image_fit | append: ';'
        -%}
        {%- if block.settings.background_video != blank -%}
          {{
            block.settings.background_video
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              class: desktop_class,
              style: desktop_style
          }}
        {%- elsif block.settings.background_video_url != blank -%}
          {%- if block.settings.background_video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ block.settings.background_video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ block.settings.background_video_url.id }}&controls=0&showinfo=0&rel=0&playsinline=1"
              class="{{ desktop_class }}"
              style="{{ desktop_style }} pointer-events: none;"
              frameborder="0"
              allow="autoplay; encrypted-media"
              allowfullscreen
            ></iframe>
          {%- elsif block.settings.background_video_url.type == 'vimeo' -%}
            <iframe
              src="https://player.vimeo.com/video/{{ block.settings.background_video_url.id }}?autoplay=1&loop=1&muted=1&background=1"
              class="{{ desktop_class }}"
              style="{{ desktop_style }} pointer-events: none;"
              frameborder="0"
              allow="autoplay; fullscreen"
              allowfullscreen
            ></iframe>
          {%- endif -%}
        {%- elsif block.settings.background_image != blank -%}
          {{
            block.settings.background_image
            | image_url: width: 3000
            | image_tag:
              loading: loading_strat,
              fetchpriority: fetch_priority,
              widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000',
              class: desktop_class,
              style: desktop_style
          }}
        {%- endif -%}

        {%- if has_mobile -%}
          {%- liquid
            assign mobile_class = 'mhs__bg-item mhs__bg-mobile' | append: ken_burns
            assign mobile_style = '--mhs-bg-pos: ' | append: block.settings.image_position | append: '; --mhs-bg-fit: ' | append: block.settings.image_fit | append: ';'
          -%}
          {%- if block.settings.mobile_background_video != blank -%}
            {{
              block.settings.mobile_background_video
              | video_tag:
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true,
                class: mobile_class,
                style: mobile_style
            }}
          {%- elsif block.settings.mobile_background_video_url != blank -%}
            {%- if block.settings.mobile_background_video_url.type == 'youtube' -%}
              <iframe
                src="https://www.youtube.com/embed/{{ block.settings.mobile_background_video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ block.settings.mobile_background_video_url.id }}&controls=0&showinfo=0&rel=0&playsinline=1"
                class="{{ mobile_class }}"
                style="{{ mobile_style }} pointer-events: none;"
                frameborder="0"
                allow="autoplay; encrypted-media"
                allowfullscreen
              ></iframe>
            {%- elsif block.settings.mobile_background_video_url.type == 'vimeo' -%}
              <iframe
                src="https://player.vimeo.com/video/{{ block.settings.mobile_background_video_url.id }}?autoplay=1&loop=1&muted=1&background=1"
                class="{{ mobile_class }}"
                style="{{ mobile_style }} pointer-events: none;"
                frameborder="0"
                allow="autoplay; fullscreen"
                allowfullscreen
              ></iframe>
            {%- endif -%}
          {%- elsif block.settings.mobile_background_image != blank -%}
            {{
              block.settings.mobile_background_image
              | image_url: width: 1500
              | image_tag:
                loading: loading_strat,
                fetchpriority: fetch_priority,
                widths: '375, 550, 750, 1100, 1500',
                class: mobile_class,
                style: mobile_style
            }}
          {%- endif -%}
        {%- endif -%}

        {%- if block.settings.overlay_opacity > 0 and block.settings.overlay_color != 'rgba(0,0,0,0)' -%}
          <div
            class="mhs__overlay mhs__overlay--gradient-{{ block.settings.overlay_gradient }}"
            style="
              --mhs-overlay-color: {{ block.settings.overlay_color }};
              background-color: {{ block.settings.overlay_color }};
              opacity: {{ overlay_opacity_val }};
            "
          ></div>
        {%- endif -%}

        {%- liquid
          assign anim_class = ''
          if block.settings.animation_type != 'none'
            assign anim_class = ' mhs__content-inner--anim-' | append: block.settings.animation_type
          endif

          assign eyebrow_style = ''
          assign headline_style = ''
          assign subheading_style = ''
          assign buttons_style = ''

          if block.settings.animation_type != 'none'
            if block.settings.animation_mode == 'staggered'
              assign stagger_sp = block.settings.stagger_speed | append: 's'
              assign st_del = block.settings.stagger_delay
              assign st_del_2 = st_del | times: 2
              assign st_del_3 = st_del | times: 3

              assign eyebrow_style = 'style="--anim-speed: ' | append: stagger_sp | append: '; --anim-delay: 0s;"'
              assign headline_style = 'style="--anim-speed: ' | append: stagger_sp | append: '; --anim-delay: ' | append: st_del | append: 's;"'
              assign subheading_style = 'style="--anim-speed: ' | append: stagger_sp | append: '; --anim-delay: ' | append: st_del_2 | append: 's;"'
              assign buttons_style = 'style="--anim-speed: ' | append: stagger_sp | append: '; --anim-delay: ' | append: st_del_3 | append: 's;"'
            else
              assign eyebrow_style = 'style="--anim-speed: ' | append: block.settings.individual_speed_eyebrow | append: 's; --anim-delay: ' | append: block.settings.individual_delay_eyebrow | append: 's;"'
              assign headline_style = 'style="--anim-speed: ' | append: block.settings.individual_speed_headline | append: 's; --anim-delay: ' | append: block.settings.individual_delay_headline | append: 's;"'
              assign subheading_style = 'style="--anim-speed: ' | append: block.settings.individual_speed_subheading | append: 's; --anim-delay: ' | append: block.settings.individual_delay_subheading | append: 's;"'
              assign buttons_style = 'style="--anim-speed: ' | append: block.settings.individual_speed_buttons | append: 's; --anim-delay: ' | append: block.settings.individual_delay_buttons | append: 's;"'
            endif
          endif
        -%}

        <div
          class="mhs__content {{ hc }} {{ vc }} {{ tac }}"
          style="color: {{ block.settings.text_color }};"
        >
          <div
            class="mhs__content-inner{% if block.settings.content_bg_style != 'none' %} mhs__content-inner--bg-{{ block.settings.content_bg_style }}{% endif %}{% if block.settings.text_shadow != 'none' %} mhs__shadow-{{ block.settings.text_shadow }}{% endif %}{{ anim_class }}"
            style="max-width: {{ block.settings.content_max_width }}px;{% if block.settings.content_bg_style == 'solid' %} --mhs-bg-solid: {{ block.settings.content_bg_color }};{% endif %}"
          >
            {%- if block.settings.eyebrow != blank -%}
              <div class="mhs__anim-wrapper" {{ eyebrow_style }}>
                <p
                  class="mhs__eyebrow{% if block.settings.eyebrow_style == 'badge' %} mhs__eyebrow--badge{% endif %}"
                  {% if block.settings.eyebrow_style == 'badge' %}
                    style="--badge-bg: {{ block.settings.eyebrow_badge_bg }}; --badge-color: {{ block.settings.eyebrow_badge_color }};"
                  {% endif %}
                >
                  {{ block.settings.eyebrow | escape }}
                </p>
              </div>
            {%- endif -%}

            {%- if block.settings.headline != blank -%}
              <div class="mhs__anim-wrapper" {{ headline_style }}>
                <h2 class="mhs__headline">{{ block.settings.headline | escape }}</h2>
              </div>
            {%- endif -%}

            {%- if block.settings.subheading != blank -%}
              <div class="mhs__anim-wrapper" {{ subheading_style }}>
                <div class="mhs__subheading">{{ block.settings.subheading }}</div>
              </div>
            {%- endif -%}

            {%- if block.settings.button_one_label != blank or block.settings.button_two_label != blank -%}
              <div class="mhs__anim-wrapper mhs__buttons" {{ buttons_style }}>
                {%- if block.settings.button_one_label != blank -%}
                  <a
                    href="{{ block.settings.button_one_link | default: '#' }}"
                    class="mhs__btn mhs__btn--{{ btn1_style }}"
                    style="
                      {%- if btn1_style == 'filled' -%}
                        background-color: {{ btn1_bg }};
                        color: {{ btn1_text }};
                        border-color: {{ btn1_bg }};
                      {%- elsif btn1_style == 'outlined' -%}
                        background-color: transparent;
                        color: {{ btn1_text }};
                        border-color: {{ btn1_text }};
                      {%- else -%}
                        color: {{ btn1_text }};
                      {%- endif -%}
                    "
                  >
                    {{- block.settings.button_one_label | escape -}}
                  </a>
                {%- endif -%}

                {%- if block.settings.button_two_label != blank -%}
                  <a
                    href="{{ block.settings.button_two_link | default: '#' }}"
                    class="mhs__btn mhs__btn--{{ btn2_style }}"
                    style="
                      {%- if btn2_style == 'filled' -%}
                        background-color: {{ btn2_bg }};
                        color: {{ btn2_text }};
                        border-color: {{ btn2_bg }};
                      {%- elsif btn2_style == 'outlined' -%}
                        background-color: transparent;
                        color: {{ btn2_text }};
                        border-color: {{ btn2_text }};
                      {%- else -%}
                        color: {{ btn2_text }};
                      {%- endif -%}
                    "
                  >
                    {{- block.settings.button_two_label | escape -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>

        {%- if block.settings.whole_slide_link != blank -%}
          <a
            href="{{ block.settings.whole_slide_link }}"
            class="mhs__slide-link"
            aria-label="Go to {{ block.settings.headline | default: 'slide' }}"
          ></a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  {%- comment -%} /.mhs__track {%- endcomment -%}

  {%- if show_arrows and section.blocks.size > 1 -%}
    <button class="mhs__arrow mhs__arrow--prev" data-mhs-prev aria-label="Previous slide">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <path d="M14 17L8 11L14 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button class="mhs__arrow mhs__arrow--next" data-mhs-next aria-label="Next slide">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <path d="M8 5L14 11L8 17" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  {%- endif -%}

  {%- if show_dots and section.blocks.size > 1 -%}
    <div class="mhs__dots" role="tablist" aria-label="Slide navigation" data-mhs-dots>
      {%- for block in section.blocks -%}
        <button
          class="mhs__dot mhs__dot--{{ dot_style }}{% if forloop.first %} is-active{% endif %}"
          data-mhs-dot="{{ forloop.index0 }}"
          role="tab"
          aria-label="Go to slide {{ forloop.index }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        >
          {%- if dot_style == 'number' -%}{{ forloop.index }}{%- endif -%}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var sectionEl = document.getElementById('shopify-section-{{ section.id }}');
    if (!sectionEl) return;

    var slider = sectionEl.querySelector('[data-mhs]');
    var track = sectionEl.querySelector('[data-mhs-track]');
    var slides = Array.from(sectionEl.querySelectorAll('[data-mhs-slide]'));
    var dotsEl = sectionEl.querySelector('[data-mhs-dots]');
    var dots = dotsEl ? Array.from(dotsEl.querySelectorAll('[data-mhs-dot]')) : [];
    var prevBtn = sectionEl.querySelector('[data-mhs-prev]');
    var nextBtn = sectionEl.querySelector('[data-mhs-next]');
    var total = slides.length;

    if (total <= 1) return;

    var current = 0;
    var timer = null;
    var isAutoplay = slider.dataset.autoplay === 'true';
    var speed = (parseInt(slider.dataset.autoplaySpeed, 10) || 5) * 1000;

    var transType = slider.dataset.transition;
    var isAbsoluteMode =
      transType === 'fade' || transType === 'scale' || transType === 'parallax' || transType === 'reveal';

    if (isAbsoluteMode) {
      track.classList.add('mhs__track--absolute', 'mhs__track--' + transType);
    }

    function setSlide(index) {
      if (index === current) return;
      var prev = current;
      current = ((index % total) + total) % total;

      slides.forEach(function (s) {
        s.classList.remove('is-leaving');
      });

      slides[prev].classList.remove('is-active');
      slides[prev].classList.add('is-leaving');

      slides[current].classList.add('is-active');

      if (!isAbsoluteMode) {
        track.style.transform = 'translateX(-' + current * 100 + '%)';
      }

      dots.forEach(function (dot, i) {
        var active = i === current;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      slider.setAttribute('aria-label', 'Hero slideshow, slide ' + (current + 1) + ' of ' + total);
    }

    function next() {
      setSlide(current + 1);
    }
    function prev() {
      setSlide(current - 1);
    }

    function startAutoplay() {
      if (!isAutoplay) return;
      clearInterval(timer);
      timer = setInterval(next, speed);
    }

    function stopAutoplay() {
      clearInterval(timer);
    }

    function resetAutoplay() {
      stopAutoplay();
      startAutoplay();
    }

    if (prevBtn)
      prevBtn.addEventListener('click', function () {
        prev();
        resetAutoplay();
      });
    if (nextBtn)
      nextBtn.addEventListener('click', function () {
        next();
        resetAutoplay();
      });

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        setSlide(parseInt(dot.dataset.mhsDot, 10));
        resetAutoplay();
      });
    });

    slider.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') {
        prev();
        resetAutoplay();
      }
      if (e.key === 'ArrowRight') {
        next();
        resetAutoplay();
      }
    });

    // Touch / swipe
    var touchX = 0;
    var touchY = 0;
    slider.addEventListener(
      'touchstart',
      function (e) {
        touchX = e.touches[0].clientX;
        touchY = e.touches[0].clientY;
      },
      { passive: true }
    );
    slider.addEventListener(
      'touchend',
      function (e) {
        var dx = e.changedTouches[0].clientX - touchX;
        var dy = e.changedTouches[0].clientY - touchY;
        if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 44) {
          dx < 0 ? next() : prev();
          resetAutoplay();
        }
      },
      { passive: true }
    );

    // Pause on hover / focus
    slider.addEventListener('mouseenter', stopAutoplay);
    slider.addEventListener('mouseleave', startAutoplay);
    slider.addEventListener('focusin', stopAutoplay);
    slider.addEventListener('focusout', startAutoplay);

    startAutoplay();
  })();
</script>

