{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .coops-comparison-table-section {
    width: 100%;
    margin: 0 auto;
    font-family: inherit;
  }

  .cct-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .cct-heading {
    font-size: 2.2rem;
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }
  .cct-subheading {
    font-size: 1.2rem;
    font-weight: 600;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.4;
  }

  .cct-container {
    border: 3px solid;
    display: flex;
    flex-direction: column;
    margin-bottom: 1rem;
    background-color: #ffffff;
  }

  .cct-group {
    display: flex;
    flex-direction: column;
    border-bottom: 3px solid;
  }
  .cct-group:last-child {
    border-bottom: none !important;
  }

  .cct-category-col {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    flex-shrink: 0;
  }
  .cct-cat-title {
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 0.5rem 0;
  }
  .cct-cat-subtitle {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 1rem 0;
  }
  .cct-cat-features {
    font-size: 0.95rem;
    line-height: 1.4;
    opacity: 0.9;
  }
  .cct-cat-features p {
    margin: 0;
  }

  .cct-products-col {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .cct-product-row {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid #eaeaea;
  }
  .cct-product-row:last-child {
    border-bottom: none;
  }
  .cct-product-row:nth-child(even) {
    background-color: #f7f7f7;
  }

  .cct-cell {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-bottom: 1px solid #eaeaea;
  }
  .cct-cell:last-child {
    border-bottom: none;
  }

  .cct-title-cell {
    text-transform: uppercase;
  }
  .cct-product-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }
  .cct-product-price {
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
  }
  .cct-desc-cell {
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .cct-desc-cell p {
    margin: 0;
  }
  .cct-image-cell img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
    object-fit: contain;
    max-height: 200px;
  }
  .cct-image-cell svg {
    width: 100%;
    height: 150px;
    background: #e0e0e0;
  }

  .cct-btn {
    display: inline-block;
    padding: 12px 24px;
    text-transform: uppercase;
    text-align: center;
    font-weight: 700;
    text-decoration: none;
    border-radius: 4px;
    width: 100%;
    transition: opacity 0.2s ease, transform 0.1s ease;
    border: none;
    cursor: pointer;
  }
  .cct-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  /* Gallery Styles */
  .cct-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 2rem;
  }
  .cct-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 1 / 1;
    display: block;
  }
  .cct-gallery-item svg {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #e0e0e0;
    display: block;
  }

  /* Desktop Styles */
  @media screen and (min-width: 900px) {
    .cct-group {
      flex-direction: row;
    }
    .cct-category-col {
      width: 25%;
    }
    .cct-product-row {
      flex-direction: row;
    }
    .cct-cell {
      border-bottom: none;
      border-right: 1px solid #eaeaea;
    }
    .cct-cell:last-child {
      border-right: none;
    }
    .cct-title-cell {
      width: 25%;
    }
    .cct-desc-cell {
      width: 35%;
    }
    .cct-image-cell {
      width: 20%;
    }
    .cct-image-cell img, .cct-image-cell svg {
      max-height: 180px;
    }
    .cct-button-cell {
      width: 20%;
      align-items: center;
    }

    .cct-gallery {
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }
  }
{% endstyle %}

<div class="coops-comparison-table-section section-{{ section.id }}-padding">
  <div class="page-width" style="max-width: var(--page-width, 1400px); margin: 0 auto; padding: 0 1.5rem;">
     <div class="cct-header">
       {%- if section.settings.heading != blank -%}
         <h2 class="cct-heading">{{ section.settings.heading | escape }}</h2>
       {%- endif -%}
       {%- if section.settings.subheading != blank -%}
         <p class="cct-subheading">{{ section.settings.subheading | escape }}</p>
       {%- endif -%}
     </div>

     <div class="cct-container" style="border-color: {{ section.settings.border_color }};">
         {% assign current_category = null %}
         
         {% for block in section.blocks %}
           {% if block.type == 'category' %}
             {% if current_category != null %}
                </div> <!-- close cct-products-col -->
                </div> <!-- close cct-group -->
             {% endif %}
             {% assign current_category = block %}
             <div class="cct-group" style="border-color: {{ section.settings.border_color }};" {{ block.shopify_attributes }}>
               <div class="cct-category-col" style="background-color: {{ block.settings.bg_color }}; color: {{ block.settings.text_color }};">
                 <h3 class="cct-cat-title" style="color: {{ block.settings.title_color }}">{{ block.settings.title | escape }}</h3>
                 {% if block.settings.subtitle != blank %}
                    <p class="cct-cat-subtitle">{{ block.settings.subtitle | escape }}</p>
                 {% endif %}
                 {% if block.settings.features != blank %}
                    <div class="cct-cat-features">{{ block.settings.features }}</div>
                 {% endif %}
               </div>
               <div class="cct-products-col">
           {% elsif block.type == 'product_row' and current_category != null %}
               <div class="cct-product-row" {{ block.shopify_attributes }}>
                 {% assign product = all_products[block.settings.product] | default: block.settings.product %}
                 <div class="cct-cell cct-title-cell">
                   <h4 class="cct-product-title">{{ block.settings.custom_title | default: product.title | default: 'Product Title' }}</h4>
                   <p class="cct-product-price">
                     {{ block.settings.price_prefix | escape }} 
                     {% if product != blank and product.price != blank %}
                       {{ product.price | money }}
                     {% else %}
                       $0.00
                     {% endif %}
                   </p>
                 </div>
                 <div class="cct-cell cct-desc-cell">
                   <div class="cct-product-desc">{{ block.settings.description }}</div>
                 </div>
                 <div class="cct-cell cct-image-cell">
                   {% if block.settings.custom_image != blank %}
                       {% assign custom_alt = block.settings.custom_image.alt | default: product.title | escape %}
                       {{ block.settings.custom_image | image_url: width: 400 | image_tag: alt: custom_alt, loading: 'lazy' }}
                   {% elsif product != blank and product.featured_image != blank %}
                     {{ product.featured_image | image_url: width: 400 | image_tag: alt: product.title, loading: 'lazy' }}
                   {% else %}
                     {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                   {% endif %}
                 </div>
                 <div class="cct-cell cct-button-cell">
                   <a href="{{ product.url | default: '#' }}" class="btn cct-btn" style="background-color: {{ block.settings.btn_bg_color }}; color: {{ block.settings.btn_text_color }};">
                     {{ block.settings.button_text | escape }}
                   </a>
                 </div>
               </div>
           {% endif %}
         {% endfor %}
         
         {% if current_category != null %}
            </div> <!-- close cct-products-col -->
            </div> <!-- close cct-group -->
         {% endif %}
         
         {% if current_category == null %}
            <div style="padding: 3rem; text-align: center; color: #666;">
               <p>Please add a <strong>Category</strong> block first, followed by <strong>Product Row</strong> blocks to populate the table.</p>
            </div>
         {% endif %}
     </div>

     <!-- Bottom Gallery -->
     {% assign has_gallery_images = false %}
     {% for block in section.blocks %}
       {% if block.type == 'gallery_image' %}
         {% assign has_gallery_images = true %}
       {% endif %}
     {% endfor %}

     {% if has_gallery_images %}
     <div class="cct-gallery">
       {% for block in section.blocks %}
         {% if block.type == 'gallery_image' %}
           <div class="cct-gallery-item" {{ block.shopify_attributes }}>
             {% if block.settings.image != blank %}
               {{ block.settings.image | image_url: width: 600, height: 600, crop: 'center' | image_tag: loading: 'lazy' }}
             {% else %}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
             {% endif %}
           </div>
         {% endif %}
       {% endfor %}
     </div>
     {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Coop's Comparison Table",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NOT SURE WHICH FAN IS RIGHT FOR YOU?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "SEE THE BENEFITS OF WALL MOUNT AND CEILING MOUNT OPTIONS"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Table Border Color",
      "default": "#ffcc00"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "WALL MOUNT"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#ffcc00"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Great for"
        },
        {
          "type": "richtext",
          "id": "features",
          "label": "Features Text",
          "default": "<p>Restaurants; Covered patios; Modern design; Private patios; Stylish Matte Black Design; Secure structure; Wall or post; Multiple fans; Quiet</p>"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background Color",
          "default": "#222222"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#ffffff"
        }
      ]
    },
    {
      "type": "product_row",
      "name": "Product Row",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Product Title",
          "info": "Overrides the default product title."
        },
        {
          "type": "text",
          "id": "price_prefix",
          "label": "Price Prefix Text",
          "default": "From"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Product Specifications",
          "default": "<p>Post mounting; Maximum width of coverage (300 degree adjustability, when not limited by wall); No assembly required</p>"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Product Image",
          "info": "Overrides the default product featured image."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Buy Now"
        },
        {
          "type": "color",
          "id": "btn_bg_color",
          "label": "Button Background Color",
          "default": "#ffcc00"
        },
        {
          "type": "color",
          "id": "btn_text_color",
          "label": "Button Text Color",
          "default": "#000000"
        }
      ]
    },
    {
      "type": "gallery_image",
      "name": "Gallery Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coop's Comparison Table",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "product_row"
        },
        {
          "type": "product_row"
        },
        {
          "type": "category",
          "settings": {
              "title": "CEILING MOUNT",
              "features": "<p>Space saving; Stylish Matte Black Design</p>"
          }
        },
        {
          "type": "product_row"
        },
        {
          "type": "gallery_image"
        },
        {
          "type": "gallery_image"
        },
        {
          "type": "gallery_image"
        },
        {
          "type": "gallery_image"
        }
      ]
    }
  ]
}
{% endschema %}
