{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .coops-dynamic-gallery-{{ section.id }} {
    width: 100%;
    margin: 0 auto;
    font-family: inherit;
    overflow: hidden; 
  }

  .cdg-header-{{ section.id }} {
    text-align: {{ section.settings.text_alignment }};
    margin-bottom: 2rem;
  }
  .cdg-heading-{{ section.id }} {
    font-size: 2.2rem;
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }
  .cdg-subheading-{{ section.id }} {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.4;
  }

  /* Grid Layout (Masonry.js) */
  .cdg-grid-{{ section.id }} {
    --gap: {{ section.settings.gap }}px;
    --cols-mobile: {{ section.settings.columns_mobile }};
    --cols-desktop: {{ section.settings.columns_desktop }};
    
    /* Calculate basic mobile unit width */
    --item-w-mobile: calc((100% - (var(--gap) * (var(--cols-mobile) - 1))) / var(--cols-mobile));
    /* Calculate basic desktop unit width */
    --item-w-desktop: calc((100% - (var(--gap) * (var(--cols-desktop) - 1))) / var(--cols-desktop));
    
    position: relative; /* required by Masonry */
  }

  .cdg-grid-sizer-{{ section.id }} { width: var(--item-w-mobile); }
  .cdg-gutter-sizer-{{ section.id }} { width: var(--gap); }

  .cdg-item-{{ section.id }} {
    width: calc(var(--item-w-mobile) * var(--span-mobile) + var(--gap) * (var(--span-mobile) - 1));
    margin-bottom: var(--gap);
    position: relative;
    display: block;
    overflow: hidden;
    text-decoration: none;
    border-radius: {{ section.settings.border_radius }}px;
  }
  
  @media screen and (min-width: 750px) {
    .cdg-grid-sizer-{{ section.id }} { width: var(--item-w-desktop); }
    .cdg-item-{{ section.id }} {
      width: calc(var(--item-w-desktop) * var(--span-desktop) + var(--gap) * (var(--span-desktop) - 1));
    }
  }

  /* Item Content Styles */
  .cdg-item-{{ section.id }} img, 
  .cdg-item-{{ section.id }} svg {
    display: block;
    width: 100%;
    height: auto;
    background-color: #f4f4f4;
    transition: transform 0.4s ease;
  }

  .cdg-item-{{ section.id }}:hover img {
    {% if section.settings.hover_zoom %}
      transform: scale(1.05);
    {% endif %}
  }

  /* Caption Styles */
  .cdg-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 1rem;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0) 100%);
    color: #fff;
    font-weight: 600;
    font-size: 1.1rem;
    text-align: {{ section.settings.text_alignment }};
    pointer-events: none;
    {% if section.settings.caption_hover_only %}
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.3s ease, transform 0.3s ease;
    {% endif %}
  }
  
  {% if section.settings.caption_hover_only %}
  .cdg-item-{{ section.id }}:hover .cdg-caption {
    opacity: 1;
    transform: translateY(0);
  }
  {% endif %}

  /* Lightbox Styles */
  .cdg-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.92);
    display: none;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
  }
  .cdg-lightbox.is-open {
    display: flex;
  }
  .cdg-lightbox-img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 4px;
    transform: scale(0.95);
    transition: transform 0.3s ease;
    cursor: default;
  }
  .cdg-lightbox.is-open .cdg-lightbox-img {
    transform: scale(1);
  }
  .cdg-lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: rgba(255,255,255,0.15);
    border: none;
    color: #fff;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-size: 24px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
    z-index: 2;
  }
  .cdg-lightbox-close:hover {
    background: rgba(255,255,255,0.3);
  }
  .cdg-lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.15);
    border: none;
    color: #fff;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
    z-index: 2;
  }
  .cdg-lightbox-nav:hover {
    background: rgba(255,255,255,0.3);
  }
  .cdg-lightbox-prev { left: 20px; }
  .cdg-lightbox-next { right: 20px; }

  .cdg-item-{{ section.id }}[data-cdg-lightbox] {
    cursor: zoom-in;
  }
{% endstyle %}

<!-- Load Masonry & imagesLoaded -->
<script src="https://cdn.jsdelivr.net/npm/masonry-layout@4.2.2/dist/masonry.pkgd.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/imagesloaded@5.0.0/imagesloaded.pkgd.min.js" defer></script>

<div class="coops-dynamic-gallery-{{ section.id }} section-{{ section.id }}-padding" data-cdg-section="{{ section.id }}" data-cdg-lightbox-enabled="{{ section.settings.enable_lightbox }}">
  <div class="{% unless section.settings.full_width %}page-width{% endunless %}" style="{% unless section.settings.full_width %}max-width: var(--page-width, 1400px); margin: 0 auto; padding: 0 1.5rem;{% endunless %}">
    
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="cdg-header-{{ section.id }}"{% if section.settings.full_width %} style="padding: 0 1.5rem;"{% endif %}>
        {%- if section.settings.heading != blank -%}
          <h2 class="cdg-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="cdg-subheading-{{ section.id }}">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div id="cdg-grid-{{ section.id }}" class="cdg-grid-{{ section.id }}">
      
      <!-- Masonry Sizers -->
      <div class="cdg-grid-sizer-{{ section.id }}"></div>
      <div class="cdg-gutter-sizer-{{ section.id }}"></div>

      <!-- Items -->
      {% for block in section.blocks %}
        {% assign is_link = false %}
        {% if block.settings.link != blank %}
          {% assign is_link = true %}
        {% endif %}
        
        {% assign lightbox_url = blank %}
        {% if section.settings.enable_lightbox and is_link == false and block.settings.image != blank %}
          {% assign lightbox_url = block.settings.image | image_url: width: 2000 %}
        {% endif %}

        {% assign span_desk = block.settings.column_span %}
        {% if span_desk > section.settings.columns_desktop %}
          {% assign span_desk = section.settings.columns_desktop %}
        {% endif %}
        
        {% assign span_mob = block.settings.column_span_mobile | plus: 0 %}
        {% assign cols_mob = section.settings.columns_mobile | plus: 0 %}
        {% if span_mob > cols_mob %}
          {% assign span_mob = cols_mob %}
        {% endif %}

        {% if is_link %}
          <a href="{{ block.settings.link }}" class="cdg-item-{{ section.id }}" style="--span-desktop: {{ span_desk }}; --span-mobile: {{ span_mob }};" {{ block.shopify_attributes }}>
        {% else %}
          <div class="cdg-item-{{ section.id }}" style="--span-desktop: {{ span_desk }}; --span-mobile: {{ span_mob }};" {% if lightbox_url != blank %}data-cdg-lightbox="{{ lightbox_url }}"{% endif %} {{ block.shopify_attributes }}>
        {% endif %}
        
          {% if block.settings.image != blank %}
            {% assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840' %}
            {{ block.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', widths: widths, alt: block.settings.image.alt | default: block.settings.caption | escape }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
          
          {% if block.settings.caption != blank %}
            <div class="cdg-caption">
              {{ block.settings.caption | escape }}
            </div>
          {% endif %}
          
        {% if is_link %}
          </a>
        {% else %}
          </div>
        {% endif %}
      {% endfor %}
      
    </div>
  </div>
  
  {%- if section.settings.enable_lightbox -%}
    <div class="cdg-lightbox" data-cdg-lightbox-overlay>
      <button class="cdg-lightbox-close" data-cdg-lightbox-close aria-label="Close">&times;</button>
      <button class="cdg-lightbox-nav cdg-lightbox-prev" data-cdg-lightbox-prev aria-label="Previous image">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <img class="cdg-lightbox-img" data-cdg-lightbox-img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 1000'%3E%3C/svg%3E" alt="" width="1000" height="1000">
      <button class="cdg-lightbox-nav cdg-lightbox-next" data-cdg-lightbox-next aria-label="Next image">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  {%- endif -%}
  
</div>

<script>
  function initGallery_{{ section.id | replace: "-", "_" }}() {
    const section = document.querySelector('[data-cdg-section="{{ section.id }}"]');
    if (!section) return;

    // 1. Initialize Masonry+imagesLoaded setup
    var initMasonry = function() {
      if (typeof Masonry !== 'undefined' && typeof imagesLoaded !== 'undefined') {
        var grid = document.querySelector('#cdg-grid-{{ section.id }}');
        if (grid) {
           if (grid.masonryInstance) {
             grid.masonryInstance.destroy();
           }
           var msnry = new Masonry(grid, {
            itemSelector: '.cdg-item-{{ section.id }}',
            columnWidth: '.cdg-grid-sizer-{{ section.id }}',
            gutter: '.cdg-gutter-sizer-{{ section.id }}',
            percentPosition: true,
            horizontalOrder: true
          });
          grid.masonryInstance = msnry;

          // Re-layout Masonry after each image loads
          imagesLoaded(grid).on('progress', function() {
            msnry.layout();
          });
        }
      } else {
        setTimeout(initMasonry, 50);
      }
    };
    initMasonry();

    // 2. Initialize Lightbox
    if (section.dataset.cdgLightboxEnabled === 'true') {
      const overlay = section.querySelector('[data-cdg-lightbox-overlay]');
      const lbImg = section.querySelector('[data-cdg-lightbox-img]');
      const lbClose = section.querySelector('[data-cdg-lightbox-close]');
      const lbPrev = section.querySelector('[data-cdg-lightbox-prev]');
      const lbNext = section.querySelector('[data-cdg-lightbox-next]');

      if (!overlay || !lbImg) return;

      let lbImages = [];
      let currentIdx = 0;

      function collectImages() {
        const seen = new Set();
        lbImages = [];
        const grid = document.querySelector('#cdg-grid-{{ section.id }}');
        if (!grid) return;
        
        // Query elements directly from the DOM structure
        grid.querySelectorAll('.cdg-item-{{ section.id }}[data-cdg-lightbox]').forEach(function(item) {
          const url = item.getAttribute('data-cdg-lightbox');
          if (url && !seen.has(url)) {
            seen.add(url);
            lbImages.push(url);
          }
        });
      }

      function openLightbox(url) {
        collectImages();
        currentIdx = lbImages.indexOf(url);
        if (currentIdx === -1) currentIdx = 0;
        lbImg.src = lbImages[currentIdx];
        overlay.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        overlay.classList.remove('is-open');
        document.body.style.overflow = '';
      }

      function showImage(idx) {
        if (lbImages.length === 0) return;
        currentIdx = (idx + lbImages.length) % lbImages.length;
        lbImg.src = lbImages[currentIdx];
      }

      // Add single event listener to the grid
      const grid = document.querySelector('#cdg-grid-{{ section.id }}');
      if (grid) {
        if(!grid.dataset.lbInit) {
          grid.addEventListener('click', function(e) {
            const item = e.target.closest('.cdg-item-{{ section.id }}[data-cdg-lightbox]');
            if (!item) return;
            
            const url = item.getAttribute('data-cdg-lightbox');
            if(url) {
              e.preventDefault();
              openLightbox(url);
            }
          });
          grid.dataset.lbInit = 'true';
        }
      }

      if(!overlay.dataset.lbInit) {
        lbClose.addEventListener('click', closeLightbox);
        overlay.addEventListener('click', function(e) {
          if (e.target === overlay) closeLightbox();
        });
  
        if (lbPrev) {
          lbPrev.addEventListener('click', function(e) {
            e.stopPropagation();
            showImage(currentIdx - 1);
          });
        }
        if (lbNext) {
          lbNext.addEventListener('click', function(e) {
            e.stopPropagation();
            showImage(currentIdx + 1);
          });
        }
  
        document.addEventListener('keydown', function(e) {
          if (!overlay.classList.contains('is-open')) return;
          if (e.key === 'Escape') closeLightbox();
          if (e.key === 'ArrowLeft') showImage(currentIdx - 1);
          if (e.key === 'ArrowRight') showImage(currentIdx + 1);
        });
        
        overlay.dataset.lbInit = 'true';
      }
    }
  }

  document.addEventListener('DOMContentLoaded', initGallery_{{ section.id | replace: "-", "_" }});
  
  // Theme Editor hook
  if (window.Shopify && Shopify.designMode) {
    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initGallery_{{ section.id | replace: "-", "_" }}();
      }
    });
  }
</script>

{% schema %}
{
  "name": "Coop's Dynamic Gallery",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Our Gallery"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore different styles."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_lightbox",
      "label": "Enable Lightbox",
      "info": "Clicking an image expands it full-screen. Will be overridden if the image block has a custom Link URL.",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (Mobile)",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image Spacing (Gap)",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image Corner Radius",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "hover_zoom",
      "label": "Enable Image Zoom on Hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "caption_hover_only",
      "label": "Show Captions Only On Hover",
      "default": false
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image Link (Optional)",
          "info": "Overrides the lightbox feature if filled."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (Optional)",
          "info": "Appears over the bottom of the image."
        },
        {
          "type": "header",
          "content": "Column Sizing"
        },
        {
          "type": "range",
          "id": "column_span",
          "min": 1,
          "max": 6,
          "step": 1,
          "label": "Column Span (Desktop)",
          "default": 1,
          "info": "How many columns this image takes up."
        },
        {
          "type": "select",
          "id": "column_span_mobile",
          "label": "Column Span (Mobile)",
          "options": [
            { "value": "1", "label": "1 Column" },
            { "value": "2", "label": "2 Columns" }
          ],
          "default": "1",
          "info": "How many columns this image takes up on mobile."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coop's Dynamic Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image", "settings": { "column_span": 2 } },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
