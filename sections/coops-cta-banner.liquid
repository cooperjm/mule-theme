{% style %}
  /* ── Section Padding ── */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ── Banner Wrapper ── */
  .coops-cta-banner-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: {{ section.settings.background_color }};
  }

  /* ── Background Image ── */
  {% if section.settings.background_image != blank %}
  .coops-cta-banner-{{ section.id }} .coops-cta-banner__bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  {% endif %}

  /* ── Background Overlay ── */
  .coops-cta-banner-{{ section.id }} .coops-cta-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
    pointer-events: none;
  }

  /* ── Content Container ── */
  .coops-cta-banner-{{ section.id }} .coops-cta-banner__container {
    position: relative;
    z-index: 3;
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding-left: 2rem;
    padding-right: 2rem;
    display: flex;
    {% if section.settings.content_position == 'left' %}
      justify-content: flex-start;
    {% elsif section.settings.content_position == 'center' %}
      justify-content: center;
    {% elsif section.settings.content_position == 'right' %}
      justify-content: flex-end;
    {% endif %}
  }

  /* ── Content Block ── */
  .coops-cta-banner-{{ section.id }} .coops-cta-banner__content {
    display: flex;
    gap: 20px;
    {% if section.settings.button_layout == 'inline' %}
      flex-direction: row;
      align-items: {{ section.settings.button_vertical_align }};
      width: 100%;
    {% else %}
      flex-direction: column;
      align-items: {{ section.settings.text_alignment }};
      max-width: {{ section.settings.content_width }}%;
    {% endif %}
  }

  .coops-cta-banner-{{ section.id }} .coops-cta-banner__text-wrap {
    {% if section.settings.button_layout == 'inline' %}
      flex: 1 1 auto;
      max-width: {{ section.settings.content_width }}%;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .coops-cta-banner-{{ section.id }} .coops-cta-banner__content {
      max-width: 100%;
      flex-direction: column;
      align-items: {{ section.settings.text_alignment }};
    }
    .coops-cta-banner-{{ section.id }} .coops-cta-banner__text-wrap {
      max-width: 100%;
    }
  }

  /* ── Heading ── */
  .coops-cta-banner-{{ section.id }} .coops-cta-banner__heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
    font-weight: {{ section.settings.heading_weight }};
    color: {{ section.settings.heading_color }};
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    {% if section.settings.text_alignment == 'flex-start' %}
      text-align: left;
    {% elsif section.settings.text_alignment == 'center' %}
      text-align: center;
    {% elsif section.settings.text_alignment == 'flex-end' %}
      text-align: right;
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .coops-cta-banner-{{ section.id }} .coops-cta-banner__heading {
      font-size: {{ section.settings.heading_size }}px;
    }
  }

  .coops-cta-banner-{{ section.id }} .coops-cta-banner__heading .coops-cta-banner__highlight {
    color: {{ section.settings.highlighted_color }};
  }

  /* ── Subheading ── */
  .coops-cta-banner-{{ section.id }} .coops-cta-banner__subheading {
    font-size: {{ section.settings.subheading_size_mobile }}px;
    color: {{ section.settings.subheading_color }};
    line-height: 1.5;
    margin: 0;
    {% if section.settings.text_alignment == 'flex-start' %}
      text-align: left;
    {% elsif section.settings.text_alignment == 'center' %}
      text-align: center;
    {% elsif section.settings.text_alignment == 'flex-end' %}
      text-align: right;
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .coops-cta-banner-{{ section.id }} .coops-cta-banner__subheading {
      font-size: {{ section.settings.subheading_size }}px;
    }
  }

  /* ── Button ── */
  .coops-cta-banner-{{ section.id }} .coops-cta-banner__button {
    display: inline-block;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    border-radius: {{ section.settings.button_border_radius }}px;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: opacity 0.25s ease, transform 0.25s ease;
    white-space: nowrap;
    width: fit-content;
    {% if section.settings.button_layout == 'stacked' %}
      align-self: {{ section.settings.text_alignment }};
    {% endif %}
  }

  .coops-cta-banner-{{ section.id }} .coops-cta-banner__button:hover {
    opacity: 0.85;
    transform: scale(1.02);
  }
{% endstyle %}

{%- comment -%} Build highlighted heading {%- endcomment -%}
{% if section.settings.highlighted_text != blank %}
  {% assign highlight_span = '<span class="coops-cta-banner__highlight">'
    | append: section.settings.highlighted_text
    | append: '</span>'
  %}
{% endif %}
{% assign rendered_heading = section.settings.heading_text | replace: '{highlighted_text}', highlight_span %}

<section class="coops-cta-banner-{{ section.id }} section-{{ section.id }}-padding">
  {%- comment -%} Background image {%- endcomment -%}
  {% if section.settings.background_image != blank %}
    {{
      section.settings.background_image
      | image_url: width: 2000
      | image_tag: class: 'coops-cta-banner__bg-image', loading: 'lazy'
    }}
  {% endif %}

  {%- comment -%} Background overlay {%- endcomment -%}
  {% if section.settings.overlay_opacity > 0 %}
    <div class="coops-cta-banner__overlay"></div>
  {% endif %}

  <div class="coops-cta-banner__container">
    <div class="coops-cta-banner__content">
      {% if section.settings.heading_text != blank %}
        <h2 class="coops-cta-banner__heading">{{ rendered_heading }}</h2>
      {% endif %}

      {% if section.settings.subheading_text != blank %}
        <p class="coops-cta-banner__subheading">{{ section.settings.subheading_text }}</p>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          href="{{ section.settings.button_link }}"
          class="coops-cta-banner__button"
        >
          {{ section.settings.button_text | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coop's CTA Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 28
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "label": "Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image",
      "info": "Covers the entire banner. Will stretch to fill."
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 0,
      "info": "Darkens the background image. 0 = no overlay."
    },
    {
      "type": "header",
      "content": "Content Position"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position",
      "info": "Where the text and button sit on the banner.",
      "options": [
        { "value": "left", "label": "Left Half" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right Half" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Content Width",
      "info": "Width of the text and button container.",
      "default": 50
    },
    {
      "type": "select",
      "id": "button_layout",
      "label": "Button Layout",
      "info": "Place the button next to the text or below it.",
      "options": [
        { "value": "inline", "label": "Inline (next to text)" },
        { "value": "stacked", "label": "Stacked (below text)" }
      ],
      "default": "inline"
    },
    {
      "type": "select",
      "id": "button_vertical_align",
      "label": "Button Vertical Alignment (Inline)",
      "info": "Only applies when Button Layout is Inline.",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "info": "Alignment of text within the content block.",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading Text",
      "info": "Use {highlighted_text} where you want the highlighted portion.",
      "default": "READY FOR {highlighted_text} AVAILABLE?"
    },
    {
      "type": "text",
      "id": "highlighted_text",
      "label": "Highlighted Text",
      "default": "THE HARDEST WORKING SHOP FAN"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "highlighted_color",
      "label": "Highlighted Text Color",
      "default": "#FDBF06"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 14,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Heading Size (Desktop)",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading Size (Mobile)",
      "default": 20
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-Bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra Bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "800"
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "textarea",
      "id": "subheading_text",
      "label": "Subheading Text"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#cccccc"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Subheading Size (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Subheading Size (Mobile)",
      "default": 14
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get Your MULE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#FDBF06"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button Border Color",
      "default": "#FDBF06"
    },
    {
      "type": "range",
      "id": "button_border_width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Button Border Width",
      "default": 2
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Button Border Radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_padding_x",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Button Horizontal Padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "button_padding_y",
      "min": 6,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Button Vertical Padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button Font Size",
      "default": 14
    },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "Button Font Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    }
  ],
  "presets": [
    {
      "name": "Coop's CTA Banner"
    }
  ]
}
{% endschema %}
