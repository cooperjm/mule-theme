{%- style -%}
  {%- if section.settings.section_height == 'adapt' -%}
    {%- assign desktop_ratio = section.settings.image.aspect_ratio | default: 2.0 -%}
    {%- assign mobile_ratio = section.settings.image_mobile.aspect_ratio | default: desktop_ratio -%}
    .coops-hero-{{ section.id }}.hero--adapt {
      aspect-ratio: {{ desktop_ratio }};
    }
    @media screen and (max-width: 768px) {
      .coops-hero-{{ section.id }}.hero--adapt {
        aspect-ratio: {{ mobile_ratio }};
        min-height: auto;
      }
    }
  {%- endif -%}

  .coops-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    background-color: #f4f4f4;
    overflow: hidden;
  }

  /* Height settings */
  .coops-hero-{{ section.id }}.hero--small { min-height: 400px; }
  .coops-hero-{{ section.id }}.hero--medium { min-height: 600px; }
  .coops-hero-{{ section.id }}.hero--large { min-height: 800px; }
  .coops-hero-{{ section.id }}.hero--full { min-height: 100vh; }

  /* Background Image Setup */
  .coops-hero__bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 1;
  }
  .coops-hero__bg img, .coops-hero__bg svg {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .coops-hero__bg--mobile { display: none; }

  @media screen and (max-width: 768px) {
    {% if section.settings.image_mobile != blank %}
      .coops-hero__bg--desktop { display: none !important; }
      .coops-hero__bg--mobile { display: block !important; }
    {% endif %}
    /* Scale down heights on mobile slightly */
    .coops-hero-{{ section.id }}.hero--small { min-height: 300px; }
    .coops-hero-{{ section.id }}.hero--medium { min-height: 450px; }
    .coops-hero-{{ section.id }}.hero--large { min-height: 600px; }
  }

  /* Overlay */
  .coops-hero__overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  /* Content Box */
  .coops-hero__content {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
    text-align: {{ section.settings.text_alignment }};
    color: {{ section.settings.text_color }};
  }

  /* Typography */
  .coops-hero__heading {
    color: inherit;
    margin: 0 0 15px 0;
    line-height: 1.1;
    font-weight: 700;
  }
  .heading--small { font-size: 2.5rem; }
  .heading--medium { font-size: 3.5rem; }
  .heading--large { font-size: 4.5rem; }

  .coops-hero__subheading {
    font-size: 1.2rem;
    margin: 0 0 30px 0;
    line-height: 1.5;
    max-width: 800px;
    {% if section.settings.text_alignment == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
  }

  /* Buttons */
  .coops-hero__buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    {% if section.settings.text_alignment == 'center' %}justify-content: center;{% endif %}
    {% if section.settings.text_alignment == 'right' %}justify-content: flex-end;{% endif %}
  }
  .coops-hero-btn {
    display: inline-block;
    padding: 14px 34px;
    text-decoration: none;
    font-weight: 600;
    border-radius: 4px;
    transition: all 0.3s ease;
    text-align: center;
  }
  .coops-hero-btn--primary {
    background-color: {{ section.settings.btn_color }};
    color: {{ section.settings.btn_text_color }};
    border: 2px solid {{ section.settings.btn_color }};
  }
  .coops-hero-btn--primary:hover {
    background-color: transparent;
    color: {{ section.settings.btn_color }};
  }
  .coops-hero-btn--secondary {
    background-color: transparent;
    color: {{ section.settings.btn_color }};
    border: 2px solid {{ section.settings.btn_color }};
  }
  .coops-hero-btn--secondary:hover {
    background-color: {{ section.settings.btn_color }};
    color: {{ section.settings.btn_text_color }};
  }

  @media screen and (max-width: 768px) {
    .heading--large { font-size: 3.2rem; }
    .heading--medium { font-size: 2.6rem; }
    .heading--small { font-size: 2rem; }
    .coops-hero__buttons { flex-direction: column; width: 100%; }
    .coops-hero-btn { width: 100%; }

    .coops-hero-{{ section.id }}.hero--text-below-mobile {
      flex-direction: column;
      align-items: stretch;
      min-height: auto !important;
    }
    .coops-hero-{{ section.id }}.hero--text-below-mobile .coops-hero__bg {
      position: relative;
      width: 100%;
      height: auto;
      aspect-ratio: {{ mobile_ratio }};
      min-height: auto;
    }
    .coops-hero-{{ section.id }}.hero--text-below-mobile .coops-hero__overlay {
      display: none;
    }
    .coops-hero-{{ section.id }}.hero--text-below-mobile .coops-hero__content {
      position: relative;
      padding: 30px 20px;
    }
  }
{%- endstyle -%}

<div class="coops-hero-{{ section.id }} hero--{{ section.settings.section_height }}{% if section.settings.show_text_below_mobile %} hero--text-below-mobile{% endif %}">
  <!-- Background Images -->
  <div class="coops-hero__bg">
    {%- if section.settings.image != blank -%}
      <img
        class="coops-hero__bg--desktop"
        src="{{ section.settings.image | image_url: width: 2000 }}"
        alt="{{ section.settings.heading | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="lazy"
      >
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg coops-hero__bg--desktop' }}
    {%- endif -%}

    {%- if section.settings.image_mobile != blank -%}
      <img
        class="coops-hero__bg--mobile"
        src="{{ section.settings.image_mobile | image_url: width: 800 }}"
        alt="{{ section.settings.heading | escape }}"
        width="{{ section.settings.image_mobile.width }}"
        height="{{ section.settings.image_mobile.height }}"
        loading="lazy"
      >
    {%- endif -%}
  </div>

  <!-- Overlay -->
  <div class="coops-hero__overlay"></div>

  <!-- Content -->
  <div class="coops-hero__content">
    {%- if section.settings.heading != blank -%}
      <h2 class="coops-hero__heading heading--{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <div class="coops-hero__subheading">{{ section.settings.subheading }}</div>
    {%- endif -%}

    {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
      <div class="coops-hero__buttons">
        {%- if section.settings.button_1_label != blank -%}
          <a href="{{ section.settings.button_1_link | default: '#' }}" class="coops-hero-btn coops-hero-btn--primary">
            {{ section.settings.button_1_label }}
          </a>
        {%- endif -%}

        {%- if section.settings.button_2_label != blank -%}
          <a
            href="{{ section.settings.button_2_link | default: '#' }}"
            class="coops-hero-btn coops-hero-btn--secondary"
          >
            {{ section.settings.button_2_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Coops Hero Full Width",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Images Setup"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Background Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Background Image (Optional)",
      "info": "Overrides the desktop image on smaller screens"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section Height",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full Screen (100vh)" }
      ],
      "default": "adapt"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image Overlay Color",
      "default": "#000000",
      "info": "Use this to darken the image to make text readable"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "show_text_below_mobile",
      "label": "Show text below image on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Welcome to our store",
      "info": "Leave blank to hide"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtext / Description",
      "default": "Explore our latest collection and find the perfect match.",
      "info": "Leave blank to hide"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary Button Label",
      "default": "Shop Now",
      "info": "Leave blank to hide"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary Button Label",
      "info": "Secondary buttons are transparent with an outline. Leave blank to hide."
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button Theme Color",
      "default": "#ffffff",
      "info": "Changes the primary button background and secondary button outline"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Primary Button Text Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Coops Hero Full Width"
    }
  ]
}
{% endschema %}
