{{ 'product-description-images.css' | asset_url | stylesheet_tag }}
<div class="product-description-images">
    <div class="page-width product-description-images-content">
        <div class="product-description-images-images">
            <div class="product-description-image">
                {{ section.settings.main_image | image_url: width: 500 | image_tag: alt: "Product Comparison Image", loading: 'lazy'}}
            </div>
            <div class="product-description-bottom-images">
                <div class="product-description-bottom-image">
                    {{ section.settings.bottom_image_1 | image_url: width: 300 | image_tag: alt: "Product Comparison Bottom Image", loading: 'lazy'}}
                </div>
                <div class="product-description-bottom-image">
                    {{ section.settings.bottom_image_2 | image_url: width: 300 | image_tag: alt: "Product Comparison Bottom Image", loading: 'lazy'}}
                </div>
            </div>
        </div>

        <div class="product-description-content">
            <h2 class="product-description-title">
                {{ section.settings.title }}
            </h2>
            <div class="product-description-description">
                {{ section.settings.description }}
            </div>
        </div>
    </div>
</div>

{% schema %}
    {
      "name": "Product Description Image",
      "limit": 1,
      "settings": [
        {
            "type": "image_picker",
            "id": "main_image",
            "label": "Main Image"
        },
        {
            "type": "image_picker",
            "id": "bottom_image_1",
            "label": "First Bottom Image"
        },
        {
            "type": "image_picker",
            "id": "bottom_image_2",
            "label": "Second Bottom Image"
        },
        {
            "type": "text",
            "id": "title",
            "label": "Title"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description"
        }
      ],
      "presets": [
        {
          "name": "Product Description Image",
          "category": "Custom"
        }
      ]
    }
{% endschema %}
    
    