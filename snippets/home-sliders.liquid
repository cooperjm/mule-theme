<style>

.slick-dots {
  display: flex;
  justify-content: center;
  list-style-type: none;
  padding: 0;
}

.slick-dots li {
  display: inline-block;
  margin: 0 5px;
}

.slick-dots li button {
  font-size: 0;
  line-height: 0;
  width: 13px;
  height: 13px;
  border: none;
  background-color: black;
  border-radius: 50%;
  padding: 0;
  cursor: pointer;
}

.slick-dots li.slick-active button {
  background-color: #F7CD46;
}

</style>

<script>

// Seen On Logos

$(document).ready(function() {
    function initializeSlick() {
        if ($(window).width() < 660) {
            if (!$('#seen-on .logos').hasClass('slick-initialized')) {
                $('#seen-on .logos').slick({
                    slidesToShow: 3,
                    slidesToScroll: 3,
                    arrows: false,
                    infinite: false,
                    dots: false,
                    responsive: [
                        {
                            breakpoint: 660,
                            settings: {
                                slidesToShow: 3,
                                slidesToScroll: 3,
                            }
                        }
                    ]
                });
            }
        } else {
            if ($('#seen-on .logos').hasClass('slick-initialized')) {
                $('#seen-on .logos').slick('unslick');
            }
        }
    }

    initializeSlick();

    $(window).resize(function() {
        initializeSlick();
    });
});

</script>

<script>

// Reviews Slider

if ($(window).width() <= 768) {
  $('.reviews-slider').slick({
    slidesToShow: 1,
    slidesToScroll: 1,
    prevArrow: `<img src="{{ 'slider-arrow-left.svg' | asset_url }}" alt="Prev" class="slick-prev">`,
    nextArrow: `<img src="{{ 'slider-arrow-right.svg' | asset_url }}" alt="Next" class="slick-next">`,
    infinite: true,
    adaptiveHeight: true,
    dots: true
  });
}

$(window).resize(function() {
  if ($(window).width() <= 768) {
    if (!$('.reviews-slider').hasClass('slick-initialized')) {
      $('.reviews-slider').slick({
        slidesToShow: 1,
        slidesToScroll: 1,
        prevArrow: `<img src="{{ 'slider-arrow-left.svg' | asset_url }}" alt="Prev" class="slick-prev">`,
        nextArrow: `<img src="{{ 'slider-arrow-right.svg' | asset_url }}" alt="Next" class="slick-next">`,
        infinite: true,
        adaptiveHeight: true,
        dots: true
      });
    }
  } else {
    if ($('.reviews-slider').hasClass('slick-initialized')) {
      $('.reviews-slider').slick('unslick');
    }
  }
});

</script>

