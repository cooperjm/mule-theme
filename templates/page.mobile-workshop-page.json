    "image_with_content_pyDiQf": {
      "type": "image-with-content",
      "blocks": {
        "richtext_7K3mfb": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>How do you pack your MULE? <\/strong>Versatile. The applications are endless.<\/p>"
          }
        },
        "richtext_kXUXDU": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Accessories.<\/strong> Speaker. Portable Power Station. Cup & Phone Holder. Tool box. And we are just getting started. More to follow based on your feedback. Stay tuned.<\/p>"
          }
        },
        "richtext_ALCaWk": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Own it. <\/strong>Make it Yours. Run with it for your fun, your projects, your space. You get the idea.<\/p>"
          }
        }
      },
      "block_order": [
        "richtext_7K3mfb",
