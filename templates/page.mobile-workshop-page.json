    "image_with_content_3KbLhd": {
      "type": "image-with-content",
      "blocks": {
        "richtext_DyGYCW": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Cool It.<\/strong> Cool your home project area. 14” 3-speed fan on wheels. 2500 CFM.<\/p>"
          }
        },
        "richtext_BMb44h": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Plug in or Remote Area Use.<\/strong> With our Portable Power Station option.<\/p>"
          }
        },
        "richtext_L8p9Ud": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Help Keep Mosquitos & Flies Away.<\/strong> Where you need it. Sidelines, Garages, Barns, Tailgating, Camping.<\/p>"
          }
        }
      },
      "block_order": [
        "richtext_DyGYCW",
        "richtext_BMb44h",
        "richtext_L8p9Ud"
      ],
      "settings": {
        "heading_text": "HAVING FUN SHOULDN'T BE HARD WORK. <br>WHEN YOU NEED IT... BRING IT!",
        "subheading_text": "",
        "image": "shopify:\/\/shop_images\/image_7_ed279d07-c6dd-4ed1-bd6a-b631d8038c80.png",
        "image_first": false,
        "icon": "shopify:\/\/shop_images\/Icon.png",
        "title": "FAN",
        "background_color": "#f4f4f4"
      }
    },
    "image_with_content_ttdJ7T": {
      "type": "image-with-content",
      "blocks": {
        "richtext_zL3kY9": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Light Your World. <\/strong>1100 lumen 4000K LED light. Adjustable up\/down.<\/p>"
          }
        },
        "richtext_d8hfbp": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>See<\/strong> what you’ve been missing. Reduce eye strain. Work in the dark.<\/p>"
          }
        },
        "richtext_f8j3PP": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Hands Free.<\/strong> Set up and work or play while lighting your area.<\/p>"
          }
        }
      },
      "block_order": [
        "richtext_zL3kY9",
        "richtext_d8hfbp",
        "richtext_f8j3PP"
      ],
      "settings": {
        "heading_text": "",
        "subheading_text": "",
        "image": "shopify:\/\/shop_images\/image_2_b15cfcd5-ff32-4fdc-8699-37e62f2b5c83.png",
        "image_first": true,
        "icon": "shopify:\/\/shop_images\/Icon_1_431e2e6e-2650-48e2-9b6e-486db00dfa93.png",
        "title": "LIGHT",
        "background_color": "#f4f4f4"
      }
    },
    "image_with_content_CKAkPr": {
      "type": "image-with-content",
      "blocks": {
        "richtext_gizwjk": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Plug it in. <\/strong>Power Strip Options: 3 Standard outlets, 2 USB ports. On\/off rocker switch.<\/p>"
          }
        },
        "richtext_7naadP": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Charge It.<\/strong> Charge your phone, mini-cooler, lights or any USB compatible device.<\/p>"
          }
        },
        "richtext_9rK3Cz": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Power Hub.<\/strong> Extend your reach. 10 foot cord. Max load 1800 Watts.<\/p>"
          }
        }
      },
      "block_order": [
        "richtext_gizwjk",
        "richtext_7naadP",
        "richtext_9rK3Cz"
      ],
      "settings": {
        "heading_text": "",
