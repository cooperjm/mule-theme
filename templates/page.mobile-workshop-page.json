    },
    "image_with_content_Jck7ew": {
      "type": "image-with-content",
      "blocks": {
        "richtext_iWt7f7": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Your Onsite Portable Work Hub. <\/strong>Make this MULE your Fun Central, a home-away-from-home base unit.<\/p>"
          }
        },
        "richtext_jALwBn": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Everything you need<\/strong> at your fingertips. Hang all your gear and supplies.<\/p>"
          }
        },
        "richtext_pTybjH": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>4 Bungee Wraps<\/strong> for hanging gear from the tray.<\/p>"
          }
        }
      },
      "block_order": [
        "richtext_iWt7f7",
        "richtext_jALwBn",
