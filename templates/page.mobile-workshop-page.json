    },
    "image_with_content_7aCRYn": {
      "type": "image-with-content",
      "blocks": {
        "richtext_gKyPDh": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Haul All. <\/strong>Load up the Mule from the car, truck or garage to reduce trips to your drop zone. Sturdy. Maximize your mobility.<\/p>"
          }
        },
        "richtext_yjkz8b": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>300 LBS<\/strong> Loading Tray Capacity. Perfect for coolers, 5 gallon buckets, stacked gear bins or bag loads.<\/p>"
          }
        },
        "richtext_qMXHmg": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>8” No Flat Tires.<\/strong> Sturdy, durable. No more pumping tires.<\/p>"
          }
        }
      },
      "block_order": [
        "richtext_gKyPDh",
        "richtext_yjkz8b",
        "richtext_qMXHmg"
      ],
      "settings": {
        "heading_text": "",
