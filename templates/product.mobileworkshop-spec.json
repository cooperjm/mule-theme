        "mosaic_image_3": "shopify:\/\/shop_images\/mobile-workshop-img-03.png",
        "mosaic_video_embed": "<iframe width=\"560\" height=\"315\" src=\"https:\/\/www.youtube-nocookie.com\/embed\/Sz8-3Tu3pPc?si=GLxPQPEI640hCyiV\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen><\/iframe>",
        "icon_bullet_1": "shopify:\/\/shop_images\/mobile-work-battery.svg",
        "text_bullet_1": "<p><strong>Integrated power strip<\/strong> with three 110v outlets and two USB 2.0 ports lets you plug in tools and charge your phone.<\/p>",
        "icon_bullet_2": "shopify:\/\/shop_images\/mobile-work-fan.svg",
        "text_bullet_2": "<p><strong>Adjustable, 14\", 3-speed, high-velocity fan<\/strong> with 2,500 CFM can increase airflow to help you stay cool and make work a breeze and keep your worksite free of dust or fumes.<\/p>",
        "icon_bullet_3": "shopify:\/\/shop_images\/kettlebell.svg",
        "text_bullet_3": "<p><strong>300-lb loading capacity<\/strong>, the Mobile Workshop allows you to haul toolboxes, 5-gallon bucket, project materials, coolers, or other supplies.<\/p>"
      }
