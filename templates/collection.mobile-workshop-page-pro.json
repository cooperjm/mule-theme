      "blocks": {
        "richtext_DweqQc": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Cool It.<\/strong> Cool your work area. 14” 3-speed fan on wheels. 2500 CFM.<\/p>"
          }
        },
        "richtext_dUUXbc": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Fumes?<\/strong> Improve air circulation and help eliminate fumes, odors and mosquitos.<\/p>"
          }
        },
        "richtext_jLQtHB": {
          "type": "richtext",
          "settings": {
            "text": "<p><strong>Dry It. <\/strong>Help painted surfaces dry quicker. Aim it where you want it.<\/p>"
          }
        }
      },
