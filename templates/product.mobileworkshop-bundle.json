            "review_image": "shopify:\/\/shop_images\/mobile-work-review-01.png",
            "customer_review_text": "Mule 5 in 1 workshop is a clever way to help you in your shop. I was not aware of a multi workshop tool like this. My husband did the assembling. He used the manual and a video from the website."
          }
        },
        "customer_review_3XxGjK": {
          "type": "customer_review",
          "settings": {
            "customer_username": "Dan the Handyman",
            "review_image": "shopify:\/\/shop_images\/mobile-work-review-02.png",
            "customer_review_text": "This thing is great! Perfect for carting around my tools and the work light is really bright and convenient. The rigid tires make it easy to move around the job and the fan on this unit is great keeping me cool."
          }
        },
        "customer_review_PaazNM": {
          "type": "customer_review",
          "settings": {
            "customer_username": "JP3 Solutions",
            "review_image": "shopify:\/\/shop_images\/mobile-work-review-03.png",
            "customer_review_text": "Excited to use my new mobile workshop. This thing was packaged well and installation was easy to follow. I plan to use it on a basement project this weekend where I need to shine light on a dark corner."
          }
        }
      },
